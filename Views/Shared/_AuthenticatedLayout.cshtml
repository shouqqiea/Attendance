                                <path fill-rule="evenodd" d="M11.49 3.17c-.38-1.56-2.6-1.56-2.98 0a1.532 1.532 0 01-2.286.948c-1.372-.836-2.942.734-2.106 2.106.54.886.061 2.042-.947 2.287-1.561.379-1.561 2.6 0 2.978a1.532 1.532 0 01.947 2.287c-.836 1.372.734 2.942 2.106 2.106a1.532 1.532 0 012.287.947c.379 1.561 2.6 1.561 2.978 0a1.533 1.533 0 012.287-.947c1.372.836 2.942-.734 2.106-2.106a1.533 1.533 0 01.947-2.287c1.561-.379 1.561-2.6 0-2.978a1.532 1.532 0 01-.947-2.287c.836-1.372-.734-2.942-2.106-2.106a1.532 1.532 0 01-2.287-.947zM10 13a3 3 0 100-6 3 3 0 000 6z" clip-rule="evenodd"></path>
                            </svg>
                            Settings
                        </NavLink>
                    </li>
                </ul>
                @if (await Html.HasPermission("dashboard.analytics"))
                {
                    <div class="mt-8 pt-4 border-t border-[#916f34]">
                        <h3 class="text-sm font-medium text-black mb-2">Quick Stats</h3>
                        <div class="bg-white rounded-md p-3 mb-3">
                            <div class="flex justify-between items-center mb-1">
                                <span class="text-xs">Pending Requests</span>
                                <span class="text-xs font-medium">3</span>
                            </div>
                            <div class="w-full bg-gray-200 rounded-full h-1.5">
                                <div class="bg-yellow-400 h-1.5 rounded-full" style="width: 60%"></div>
                            </div>
                        </div>
                        <div class="bg-white rounded-md p-3">
                            <div class="flex justify-between items-center mb-1">
                                <span class="text-xs">Approved Today</span>
                                <span class="text-xs font-medium">2</span>
                            </div>
                            <div class="w-full bg-gray-200 rounded-full h-1.5">
                                <div class="bg-green-400 h-1.5 rounded-full" style="width: 40%"></div>
                            </div>
                        </div>
                    </div>
                }
            </nav>
            <div class="absolute bottom-0 left-0 right-0 p-4 border-t border-[#916f34]">
                <a href="/Account/Logout" class="flex items-center text-black/90 hover:text-black transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M3 3a1 1 0 00-1 1v12a1 1 0 102 0V4a1 1 0 00-1-1zm10.293 9.293a1 1 0 001.414 1.414l3-3a1 1 0 000-1.414l-3-3a1 1 0 10-1.414 1.414L14.586 9H7a1 1 0 100 2h7.586l-1.293 1.293z" clip-rule="evenodd"></path>
                    </svg>
                    Sign Out
                </a>
            </div>
        </div>

        <!-- Toggle Button for Desktop Sidebar -->
        <div class="fixed top-4 left-4 z-30 hidden md:block">
            <button id="toggleSidebar" class="bg-[#a88641] text-black p-2 rounded-md shadow-md">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
                </svg>
            </button>
        </div>

        <!-- Notification Container -->
        <div id="notificationContainer" class="fixed top-4 right-4 z-50 space-y-2 w-full max-w-xs"></div>
        <!-- Main Content -->
        <div id="mainContent" class="ml-0 md:ml-64 transition-all duration-300 p-2 md:p-6">
            <div class="max-w-7xl mx-auto bg-white rounded-lg shadow-md overflow-hidden">
                <!-- Header -->
                <header class="header-gradient text-black shadow-lg relative z-10">
                    <div class="p-4">
                        <div class="flex flex-wrap items-center justify-between w-full">
                            <!-- Logo and Title -->
                            <div class="flex items-center ml-10 sm:ml-0">
                                <img src="/images/logo-black-icon.png" alt="Logo" class="h-7 w-7" />
                                <h1 class="text-lg sm:text-xl font-bold text-black ml-2">Lets<span class="text-black">Check</span>In</h1>
                                <span class="ml-2 bg-white/10 text-black text-xs px-2 py-0.5 rounded-full">HR</span>
                            </div>

                            <!-- Date and Time - Hidden on mobile, visible on desktop -->
                            <div class="hidden sm:flex items-center space-x-4 order-3 sm:order-2 w-full sm:w-auto justify-center sm:justify-start mt-3 sm:mt-0">
                                <!-- Today's Date -->
                                <div class="flex items-center space-x-2 bg-white bg-opacity-10 rounded-lg px-3 py-1.5">
                                    <div class="bg-white rounded-full w-6 h-6 sm:w-7 sm:h-7 flex items-center justify-center">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 sm:h-4 sm:w-4" viewBox="0 0 20 20" fill="currentColor">
                                            <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd"></path>
                                        </svg>
                                    </div>
                                    <span class="text-xs sm:text-sm whitespace-nowrap">Today: <span class="font-medium" id="currentDate">May 15, 2023</span></span>
                                </div>

                                <!-- Current Time -->
                                <div class="flex items-center space-x-2 bg-white bg-opacity-10 rounded-lg px-3 py-1.5">
                                    <div class="bg-white rounded-full w-6 h-6 sm:w-7 sm:h-7 flex items-center justify-center">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 sm:h-4 sm:w-4" viewBox="0 0 20 20" fill="currentColor">
                                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"></path>
                                        </svg>
                                    </div>
                                    <span class="text-xs sm:text-sm whitespace-nowrap">Time: <span class="font-medium" id="currentTime">12:30 PM</span></span>
                                </div>
                            </div>

                            <!-- User Profile -->
                            <div class="flex items-center order-2 sm:order-3">
                                <!-- User Profile Dropdown -->
                                <div class="relative">
                                    <button id="userMenuButton" class="flex items-center space-x-2 bg-white bg-opacity-10 hover:bg-opacity-20 rounded-lg py-1.5 px-2 sm:px-3 transition-all">
                                        <div class="bg-white rounded-full w-7 h-7 sm:w-9 sm:h-9 flex items-center justify-center border-2 border-white">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 sm:h-5 sm:w-5" viewBox="0 0 20 20" fill="currentColor">
                                                <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"></path>
                                            </svg>
                                        </div>
                                        <div class="text-left hidden sm:block">
                                            <p class="text-sm font-semibold">@(User.FindFirst("FirstName")?.Value ?? "User")</p>
                                            <p class="text-xs text-black/80">@(User.FindFirst("Role")?.Value ?? User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Employee")</p>
                                        </div>
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 hidden sm:block" viewBox="0 0 20 20" fill="currentColor">
                                            <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"></path>
                                        </svg>
                                    </button>

                                    <!-- Dropdown Menu -->
                                    <div id="userDropdown" class="dropdown-menu absolute right-0 mt-2 w-56 bg-white rounded-lg shadow-xl py-2 z-20" style="background-color: #fff !important;">
                                        <div class="px-4 py-3 border-b border-gray-100">
                                            <p class="text-sm font-medium text-gray-900">@(User.FindFirst("FirstName")?.Value + " " + User.FindFirst("LastName")?.Value ?? User.Identity.Name ?? "User")</p>
                                            <p class="text-xs text-gray-500">@(User.Identity.Name ?? "user@company.com")</p>
                                        </div>
                                        <a href="#" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 flex items-center">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2 text-gray-500" viewBox="0 0 20 20" fill="currentColor">
                                                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-6-3a2 2 0 11-4 0 2 2 0 014 0zm-2 4a5 5 0 00-4.546 2.916A5.986 5.986 0 0010 16a5.986 5.986 0 004.546-2.084A5 5 0 0010 11z" clip-rule="evenodd"></path>
                                            </svg>
                                            Your Profile
                                        </a>
                                        <a href="#" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 flex items-center">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2 text-gray-500" viewBox="0 0 20 20" fill="currentColor">
                                                <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"></path>
                                            </svg>
                                            Update Password
                                        </a>
                                    </div>
                                </div>
                            </div>

                            <!-- Mobile Date and Time - Only visible on mobile -->
                            <div class="flex sm:hidden items-center space-x-3 order-4 w-full justify-center mt-3">
                                <!-- Today's Date -->
                                <div class="flex items-center space-x-2 bg-white bg-opacity-10 rounded-lg px-3 py-1.5">
                                    <div class="bg-white rounded-full w-6 h-6 flex items-center justify-center">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor">
                                            <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd"></path>
                                        </svg>
                                    </div>
                                    <span class="text-xs whitespace-nowrap">Today: <span class="font-medium" id="mobileDateDisplay">May 15</span></span>
                                </div>

                                <!-- Current Time -->
                                <div class="flex items-center space-x-2 bg-white bg-opacity-10 rounded-lg px-3 py-1.5">
                                    <div class="bg-white rounded-full w-6 h-6 flex items-center justify-center">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor">
                                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"></path>
                                        </svg>
                                    </div>
                                    <span class="text-xs whitespace-nowrap">Time: <span class="font-medium" id="mobileTimeDisplay">12:30 PM</span></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </header>
                @RenderSection("Scripts", required: false)

                @RenderBody()
            </div>
        </div>
    }
    else
    {
        <div class="flex items-center justify-center min-h-screen bg-gray-50">
            <div class="bg-white p-8 rounded shadow-md text-center">
                @RenderSection("Scripts", required: false)

                @RenderBody()
            </div>
        </div>
    }
    <iframe height="1" width="1" style="position: absolute; top: 0px; left: 0px; border: none; visibility: hidden;"></iframe>
    <script>
        // Mobile menu functionality
        document.addEventListener('DOMContentLoaded', function() {
            // Mobile menu
            document.getElementById('mobileMenuToggle')?.addEventListener('click', function() {
                const mobileSidebar = document.getElementById('mobileSidebar');
                const menuOverlay = document.getElementById('menuOverlay');
                
                mobileSidebar.classList.remove('-translate-x-full');
                mobileSidebar.classList.add('translate-x-0');
                menuOverlay.classList.remove('hidden');
            });

            document.getElementById('closeMobileMenu')?.addEventListener('click', function() {
                const mobileSidebar = document.getElementById('mobileSidebar');
                const menuOverlay = document.getElementById('menuOverlay');
                
                mobileSidebar.classList.add('-translate-x-full');
                mobileSidebar.classList.remove('translate-x-0');
                menuOverlay.classList.add('hidden');
            });

            document.getElementById('menuOverlay')?.addEventListener('click', function() {
                const mobileSidebar = document.getElementById('mobileSidebar');
                const menuOverlay = document.getElementById('menuOverlay');
                
                mobileSidebar.classList.add('-translate-x-full');
                mobileSidebar.classList.remove('translate-x-0');
                menuOverlay.classList.add('hidden');
            });

            // Desktop sidebar toggle
            let sidebarVisible = true; // Track sidebar state (visible by default)
            
            document.getElementById('toggleSidebar')?.addEventListener('click', function() {
                const mainContent = document.getElementById('mainContent');
                const desktopSidebar = document.getElementById('desktopSidebar');
                
                if (sidebarVisible) {
                    // Hide sidebar
                    desktopSidebar.classList.remove('md:block');
                    desktopSidebar.classList.add('hidden');
                    mainContent.classList.remove('md:ml-64');
                    mainContent.classList.add('md:ml-0');
                    sidebarVisible = false;
                } else {
                    // Show sidebar
                    desktopSidebar.classList.remove('hidden');
                    desktopSidebar.classList.add('md:block');
                    mainContent.classList.remove('md:ml-0');
                    mainContent.classList.add('md:ml-64');
                    sidebarVisible = true;
                }
            });

            // User menu
            document.getElementById('userMenuButton')?.addEventListener('click', function() {
                const dropdown = document.getElementById('userDropdown');
                dropdown.classList.toggle('hidden');
            });

            // Close user menu when clicking outside
            document.addEventListener('click', function(event) {
                const userMenu = document.getElementById('userDropdown');
                const userMenuButton = document.getElementById('userMenuButton');
                
                if (userMenu && userMenuButton && !userMenuButton.contains(event.target) && !userMenu.contains(event.target)) {
                    userMenu.classList.add('hidden');
                }
            });

            // Initialize current page submenu state
            const currentPath = window.location.pathname;
            if (currentPath.startsWith('/UserManagement')) {
                const submenu = document.getElementById('employeeSubmenu');
                const icon = document.getElementById('employeeSubmenuIcon');
                const mobileSubmenu = document.getElementById('mobileEmployeeSubmenu');
                const mobileIcon = document.getElementById('mobileEmployeeSubmenuIcon');
                if (submenu && icon) {
                    submenu.classList.remove('hidden');
                    icon.classList.add('rotate-180');
                }
                if (mobileSubmenu && mobileIcon) {
                    mobileSubmenu.classList.remove('hidden');
                    mobileIcon.classList.add('rotate-180');
                }
            }

            // Update time
            function updateTime() {
                const now = new Date();
                const timeDisplay = document.getElementById('mobileTimeDisplay');
                const currentTimeDisplay = document.getElementById('currentTime');
                const timeString = now.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', hour12: true });
                
                if (timeDisplay) timeDisplay.textContent = timeString;
                if (currentTimeDisplay) currentTimeDisplay.textContent = timeString;
            }

            // Update date
            function updateDate() {
                const now = new Date();
                const dateDisplay = document.getElementById('currentDate');
                const mobileDateDisplay = document.getElementById('mobileDateDisplay');
                const dateString = now.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
                const shortDateString = now.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
                
                if (dateDisplay) dateDisplay.textContent = dateString;
                if (mobileDateDisplay) mobileDateDisplay.textContent = shortDateString;
            }

            // Initial updates
            updateTime();
            updateDate();

            // Update time every minute
            setInterval(updateTime, 60000);
        });

        // Employee submenu toggle function
        document.getElementById('employeeMenuButton')?.addEventListener('click', function() {
            const submenu = document.getElementById('employeeSubmenu');
            const icon = document.getElementById('employeeSubmenuIcon');
            submenu.classList.toggle('hidden');
            icon.classList.toggle('rotate-180');
        });

        // Mobile employee submenu toggle function
        document.getElementById('mobileEmployeeMenuButton')?.addEventListener('click', function() {
            const submenu = document.getElementById('mobileEmployeeSubmenu');
            const icon = document.getElementById('mobileEmployeeSubmenuIcon');
            submenu.classList.toggle('hidden');
            icon.classList.toggle('rotate-180');
        });
    </script>
</body>
</html>
