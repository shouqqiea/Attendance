                        <li>
                            <a href="/LeaveManagement/Dashboard" class="flex items-center p-2 rounded-md hover:bg-[#916f34] hover:text-black  transition-colors @(Context.Request.Path.StartsWithSegments("/LeaveManagement/Dashboard") ? "active" : "")">
