@* Views/Shared/_LoggedLayout.cshtml *@
@using Microsoft.AspNetCore.Components.Routing
@using LetsCheckIn.Models.db
@using LetsCheckIn.Helpers
@using LetsCheckIn.Models
@using Microsoft.AspNetCore.Identity
@inject LetsCheckIn.Helpers.IDynamicPermissionService PermissionService
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LetsCheckIn</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="~/css/leave-management.css" />
    <link rel="stylesheet" href="~/css/Tailwind.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <script src="~/js/notification.js"></script>
    <script src="~/js/site.js"></script>

    <style>
        body {
            font-family: 'Inter', sans-serif;
        }
        .active, .nav-active {
            background-color: #916f34 !important;
        }
        .header-gradient {
            background: linear-gradient(135deg, #a88641, #f2d194);
        }
    </style>
</head>
<body class="bg-gray-50">
    @if (User.Identity.IsAuthenticated)
    {
        <!-- Mobile Menu Toggle Button -->
        <div class="fixed top-4 left-4 z-50 md:hidden">
            <button id="mobileMenuToggle" class="bg-[#a88641] text-black p-2 rounded-md shadow-md">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
                </svg>
            </button>
        </div>

        <!-- Mobile Menu Overlay -->
        <div id="menuOverlay" class="fixed inset-0 bg-black bg-opacity-50 z-40 hidden md:hidden"></div>

        <!-- Mobile Sidebar -->
        <div id="mobileSidebar" class="fixed top-0 left-0 h-full w-64 bg-[#a88641] text-black z-50 transform -translate-x-full transition-transform duration-300 md:hidden overflow-y-auto">
