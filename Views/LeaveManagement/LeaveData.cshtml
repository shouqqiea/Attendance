@using LetsCheckIn.Controllers
@{
    ViewBag.Title = "Leave Data";
    Layout = "~/Views/Shared/_AuthenticatedLayout.cshtml";
    var leaveRequests = ViewBag.LeaveRequests as List<LeaveDataViewModel> ?? new List<LeaveDataViewModel>();
    var leaveTypes = ViewBag.LeaveTypes as List<string> ?? new List<string>();
    var statuses = ViewBag.Statuses as List<string> ?? new List<string>();
}

<div id="notificationContainer" class="fixed top-4 right-4 z-50"></div>

<div class="p-4 sm:p-6 max-w-7xl mx-auto">
    <!-- Header Section -->
    <div class="mb-6">
        <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-2">Leave Data</h1>
        <p class="text-sm sm:text-base text-gray-600">View and analyze leave request data across your organization</p>
    </div>

    <!-- Filters Section -->
    <div class="bg-white rounded-lg shadow-sm p-4 sm:p-6 mb-6">
        <form method="get" class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6 gap-4">
                <!-- Search -->
                <div class="sm:col-span-2">
                    <label class="block text-sm font-medium text-gray-700 mb-1">Search</label>
                    <div class="relative">
                        <input type="text" 
                               name="search" 
                               value="@ViewBag.Search" 
                               placeholder="Employee name, email, or leave type..." 
                               class="w-full pl-10 pr-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#a88641] focus:border-[#a88641] transition-colors"
                               aria-label="Search leave requests" />
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                            <svg class="h-5 w-5 text-gray-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd" />
                            </svg>
                        </div>
                    </div>
                </div>

                <!-- Leave Type Filter -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Leave Type</label>
                    <select name="leaveType" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#a88641] focus:border-[#a88641] transition-colors">
                        <option value="">All Types</option>
                        @foreach (var type in leaveTypes)
                        {
                            <option value="@type" selected="@(ViewBag.SelectedLeaveType == type)">@type</option>
                        }
                    </select>
                </div>

                <!-- Status Filter -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Status</label>
                    <select name="status" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#a88641] focus:border-[#a88641] transition-colors">
                        <option value="">All Status</option>
                        @foreach (var status in statuses)
                        {
                            <option value="@status" selected="@(ViewBag.SelectedStatus == status)">@status</option>
                        }
                    </select>
                </div>

                <!-- Start Date Filter -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Start Date</label>
                    <input type="date" 
                           name="startDate" 
                           value="@ViewBag.StartDate" 
                           class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#a88641] focus:border-[#a88641] transition-colors" />
                </div>

                <!-- End Date Filter -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">End Date</label>
                    <input type="date" 
                           name="endDate" 
                           value="@ViewBag.EndDate" 
                           class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#a88641] focus:border-[#a88641] transition-colors" />
                </div>
            </div>

            <!-- Filter Actions -->
            <div class="flex flex-col sm:flex-row gap-3 sm:justify-between">
                <div class="flex flex-col sm:flex-row gap-3">
                    <!-- Export Buttons -->
                    <div class="flex gap-2">
                        <button type="button" 
                                onclick="exportData('excel')" 
                                class="inline-flex items-center justify-center px-3 py-2 border border-green-300 rounded-md shadow-sm text-sm font-medium text-green-700 bg-green-50 hover:bg-green-100 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500 transition-colors"
                                title="Export to Excel (.xlsx)">
                            <svg class="h-4 w-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                            </svg>
                            Excel
                        </button>
                        <button type="button" 
                                onclick="exportData('csv')" 
                                class="inline-flex items-center justify-center px-3 py-2 border border-blue-300 rounded-md shadow-sm text-sm font-medium text-blue-700 bg-blue-50 hover:bg-blue-100 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors"
                                title="Export to CSV">
                            <svg class="h-4 w-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                            </svg>
                            CSV
                        </button>
                    </div>
                </div>
                <div class="flex flex-col sm:flex-row gap-3">
                    <a href="/LeaveManagement/LeaveData" class="inline-flex items-center justify-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#a88641] transition-colors">
                        <svg class="h-4 w-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                        </svg>
                        Clear Filters
                    </a>
                    <button type="submit" class="inline-flex items-center justify-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-[#a88641] hover:bg-[#916f34] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#a88641] transition-colors">
                        <svg class="h-4 w-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.707A1 1 0 013 7V4z" />
                        </svg>
                        Apply Filters
                    </button>
                </div>
            </div>
        </form>
    </div>

    <!-- Results Section -->
    <div class="bg-white rounded-lg shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <!-- Mobile View (Card Layout) -->
            <div class="sm:hidden">
                @if (!leaveRequests.Any())
                {
                    <div class="p-6 text-center">
                        <svg class="h-12 w-12 text-[#a88641] mx-auto mb-3" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                        </svg>
                        <p class="text-gray-500 mb-1">No leave requests found</p>
                        <p class="text-sm text-gray-400">Try adjusting your filters</p>
                    </div>
                }
                @foreach (var request in leaveRequests)
                {
                    var statusClass = request.Status.ToLower() switch
                    {
                        "approved" => "bg-green-100 text-green-800",
                        "rejected" => "bg-red-100 text-red-800",
                        "cancelled" => "bg-gray-100 text-gray-800",
                        "pending" => "bg-yellow-100 text-yellow-800",
                        "emergency" => "bg-orange-100 text-orange-800",
                        _ => "bg-blue-100 text-blue-800"
                    };

                    <div class="p-4 border-b border-gray-200">
                        <div class="flex justify-between items-start mb-3">
                            <div>
                                <h3 class="text-lg font-medium text-gray-900">@request.EmployeeName</h3>
                                <p class="text-sm text-gray-500">@request.EmployeeEmail</p>
                            </div>
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium @statusClass">
                                @request.Status
                            </span>
                        </div>
                        <div class="space-y-2">
                            <div>
                                <p class="text-sm font-medium text-gray-500">Leave Type & Duration</p>
                                <p class="text-sm text-gray-900">@request.LeaveType • @request.Duration days</p>
                            </div>
                            <div>
                                <p class="text-sm font-medium text-gray-500">Period</p>
                                <p class="text-sm text-gray-900">@request.StartDate.ToString("MMM dd") - @request.EndDate.ToString("MMM dd, yyyy")</p>
                            </div>
                            <div>
                                <p class="text-sm font-medium text-gray-500">Submitted</p>
                                <p class="text-sm text-gray-900">@request.SubmittedOn.ToString("MMM dd, yyyy")</p>
                            </div>
                            <div>
                                <p class="text-sm font-medium text-gray-500">Reason</p>
                                <p class="text-sm text-gray-900">@request.Reason</p>
                            </div>
                            @if (!string.IsNullOrEmpty(request.ActionPerformedBy) && request.ActionPerformedOn.HasValue)
                            {
                                <div>
                                    <p class="text-sm font-medium text-gray-500">Action Performed By</p>
                                    <p class="text-sm text-gray-900">@request.ActionPerformedBy</p>
                                    <p class="text-xs text-gray-500">@request.ActionPerformedOn?.ToString("MMM dd, yyyy 'at' hh:mm tt")</p>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(request.AttachmentFileName))
                            {
                                <div class="pt-2">
                                    <a href="/LeaveManagement/DownloadAttachment/@request.Id" 
                                       class="inline-flex items-center text-sm text-[#a88641] hover:text-[#916f34]">
                                        <svg class="h-4 w-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13" />
                                        </svg>
                                        View Attachment
                                    </a>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- Desktop View (Table Layout) -->
            <table class="hidden sm:table min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Employee</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Leave Details</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Period</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Action By</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Submitted</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    @if (!leaveRequests.Any())
                    {
                        <tr>
                            <td colspan="7" class="px-6 py-8 text-center text-sm text-gray-500">
                                <div class="flex flex-col items-center justify-center">
                                    <svg class="h-12 w-12 text-[#a88641] mb-3" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                                    </svg>
                                    <p class="text-gray-500 mb-1">No leave requests found</p>
                                    <p class="text-sm text-gray-400">Try adjusting your filters</p>
                                </div>
                            </td>
                        </tr>
                    }
                    @foreach (var request in leaveRequests)
                    {
                        var statusClass = request.Status.ToLower() switch
                        {
                            "approved" => "bg-green-100 text-green-800",
                            "rejected" => "bg-red-100 text-red-800",
                            "cancelled" => "bg-gray-100 text-gray-800",
                            "pending" => "bg-yellow-100 text-yellow-800",
                            "emergency" => "bg-orange-100 text-orange-800",
                            _ => "bg-blue-100 text-blue-800"
                        };

                        <tr class="hover:bg-gray-50 transition-colors">
                            <td class="px-6 py-4">
                                <div class="text-sm font-medium text-gray-900">@request.EmployeeName</div>
                                <div class="text-sm text-gray-500">@request.EmployeeEmail</div>
                            </td>
                            <td class="px-6 py-4">
                                <div class="text-sm font-medium text-gray-900">@request.LeaveType</div>
                                <div class="text-sm text-gray-500">@request.Duration days</div>
                                <div class="text-sm text-gray-500 mt-1">@request.Reason</div>
                            </td>
                            <td class="px-6 py-4">
                                <div class="text-sm text-gray-900">@request.StartDate.ToString("MMM dd, yyyy")</div>
                                <div class="text-sm text-gray-500">to @request.EndDate.ToString("MMM dd, yyyy")</div>
                            </td>
                            <td class="px-6 py-4">
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium @statusClass">
                                    @request.Status
                                </span>
                                @if (!string.IsNullOrEmpty(request.RejectionReason))
                                {
                                    <div class="text-xs text-red-600 mt-1">@request.RejectionReason</div>
                                }
                            </td>
                            <td class="px-6 py-4">
                                @if (!string.IsNullOrEmpty(request.ActionPerformedBy) && request.ActionPerformedOn.HasValue)
                                {
                                    <div class="text-sm text-gray-900">@request.ActionPerformedBy</div>
                                    <div class="text-sm text-gray-500">@request.ActionPerformedOn?.ToString("MMM dd, yyyy")</div>
                                    <div class="text-xs text-gray-400">@request.ActionPerformedOn?.ToString("HH:mm")</div>
                                }
                                else
                                {
                                    <div class="text-sm text-gray-400">-</div>
                                }
                            </td>
                            <td class="px-6 py-4">
                                <div class="text-sm text-gray-900">@request.SubmittedOn.ToString("MMM dd, yyyy")</div>
                                <div class="text-sm text-gray-500">@request.SubmittedOn.ToString("HH:mm")</div>
                            </td>
                            <td class="px-6 py-4">
                                <div class="flex items-center space-x-3">
                                    @if (!string.IsNullOrEmpty(request.AttachmentFileName))
                                    {
                                        <a href="/LeaveManagement/DownloadAttachment/@request.Id" 
                                           class="text-[#a88641] hover:text-[#916f34]" 
                                           title="Download Attachment">
                                            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13" />
                                            </svg>
                                        </a>
                                    }
                                    <button onclick="showRequestDetails(@request.Id)" 
                                            class="text-gray-600 hover:text-gray-800"
                                            title="View Details">
                                        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                        </svg>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Summary Section -->
    <div class="mt-6 bg-white rounded-lg shadow-sm p-4 sm:p-6">
        <h3 class="text-lg font-medium text-gray-900 mb-4">Summary</h3>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
            <div class="text-center">
                <div class="text-2xl font-bold text-gray-900">@leaveRequests.Count</div>
                <div class="text-sm text-gray-500">Total Requests</div>
            </div>
            <div class="text-center">
                <div class="text-2xl font-bold text-green-600">@leaveRequests.Count(r => r.Status.ToLower() == "approved")</div>
                <div class="text-sm text-gray-500">Approved</div>
            </div>
            <div class="text-center">
                <div class="text-2xl font-bold text-yellow-600">@leaveRequests.Count(r => r.Status.ToLower() == "pending")</div>
                <div class="text-sm text-gray-500">Pending</div>
            </div>
            <div class="text-center">
                <div class="text-2xl font-bold text-red-600">@leaveRequests.Count(r => r.Status.ToLower() == "rejected")</div>
                <div class="text-sm text-gray-500">Rejected</div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function showRequestDetails(requestId) {
            // This can be expanded to show a modal with full request details
            showNotification('Feature coming soon - detailed view for request ' + requestId, 'info');
        }

        /**
         * Export filtered leave data to Excel or CSV format
         * Preserves current filter parameters and sends them to export endpoints
         */
        function exportData(format) {
            try {
                // Get current filter values from the form
                const searchValue = document.querySelector('input[name="search"]').value || '';
                const leaveTypeValue = document.querySelector('select[name="leaveType"]').value || '';
                const statusValue = document.querySelector('select[name="status"]').value || '';
                const startDateValue = document.querySelector('input[name="startDate"]').value || '';
                const endDateValue = document.querySelector('input[name="endDate"]').value || '';

                // Build query parameters for export
                const params = new URLSearchParams();
                if (searchValue) params.append('search', searchValue);
                if (leaveTypeValue) params.append('leaveType', leaveTypeValue);
                if (statusValue) params.append('status', statusValue);
                if (startDateValue) params.append('startDate', startDateValue);
                if (endDateValue) params.append('endDate', endDateValue);

                // Determine export URL based on format
                let exportUrl;
                if (format === 'excel') {
                    exportUrl = '/LeaveManagement/ExportToExcel';
                    showNotification('Preparing Excel export...', 'info');
                } else if (format === 'csv') {
                    exportUrl = '/LeaveManagement/ExportToCsv';
                    showNotification('Preparing CSV export...', 'info');
                } else {
                    showNotification('Invalid export format specified', 'error');
                    return;
                }

                // Add query parameters to URL
                const fullUrl = params.toString() ? `${exportUrl}?${params.toString()}` : exportUrl;

                // Create invisible download link and trigger download
                const downloadLink = document.createElement('a');
                downloadLink.href = fullUrl;
                downloadLink.download = ''; // Let server determine filename
                downloadLink.style.display = 'none';
                
                document.body.appendChild(downloadLink);
                downloadLink.click();
                document.body.removeChild(downloadLink);

                // Show success notification after a short delay
                setTimeout(() => {
                    showNotification(`Export initiated successfully. Your ${format.toUpperCase()} file should download shortly.`, 'success');
                }, 1000);

            } catch (error) {
                console.error('Export error:', error);
                showNotification('An error occurred during export. Please try again.', 'error');
            }
        }

        function showNotification(message, type) {
            const container = document.getElementById('notificationContainer');
            const notification = document.createElement('div');
            notification.className = `p-4 mb-4 rounded-md ${type === 'success' ? 'bg-green-100 text-green-800' : type === 'error' ? 'bg-red-100 text-red-800' : 'bg-blue-100 text-blue-800'}`;
            notification.innerHTML = message;
            
            container.appendChild(notification);
            
            setTimeout(() => {
                notification.remove();
            }, 5000);
        }
    </script>
} 