<head>
    <script src="~/js/LeaveRequest.js"></script>
</head>
<!-- Leave Request Form -->
<div class="p-4 md:p-6" id="leaveRequestForm">
    <h3 class="text-lg font-medium text-gray-900 mb-4">Submit a New Leave Request</h3>

    <form id="leaveForm" class="space-y-4">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
                <label for="leaveType" class="block text-sm font-medium text-gray-700 mb-1">Leave Type</label>
                <select id="leaveType" name="leaveType" class="w-full border border-gray-300 rounded-md p-2 focus:ring-indigo-500 focus:border-indigo-500">
                    <option value="">Select Leave Type</option>
                    <option value="vacation">Vacation Leave</option>
                    <option value="sick">Sick Leave</option>
                    <option value="personal">Personal Leave</option>
                    <option value="emergency">Emergency Leave</option>
                    <option value="maternity">Maternity/Paternity Leave</option>
                    <option value="bereavement">Bereavement Leave</option>
                </select>
            </div>

            <div>
                <label for="emergency" class="block text-sm font-medium text-gray-700 mb-1">Is this an emergency?</label>
                <div class="flex items-center space-x-4">
                    <label class="inline-flex items-center">
                        <input type="radio" name="emergency" value="yes" class="h-4 w-4 text-indigo-600 focus:ring-indigo-500 border-gray-300">
                        <span class="ml-2 text-sm text-gray-700">Yes</span>
                    </label>
                    <label class="inline-flex items-center">
                        <input type="radio" name="emergency" value="no" class="h-4 w-4 text-indigo-600 focus:ring-indigo-500 border-gray-300" checked="">
                        <span class="ml-2 text-sm text-gray-700">No</span>
                    </label>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
                <label for="startDate" class="block text-sm font-medium text-gray-700 mb-1">Start Date</label>
                <input type="date" id="startDate" name="startDate" class="w-full border border-gray-300 rounded-md p-2 focus:ring-indigo-500 focus:border-indigo-500">
            </div>

            <div>
                <label for="endDate" class="block text-sm font-medium text-gray-700 mb-1">End Date</label>
                <input type="date" id="endDate" name="endDate" class="w-full border border-gray-300 rounded-md p-2 focus:ring-indigo-500 focus:border-indigo-500">
            </div>
        </div>

        <div>
            <label for="reason" class="block text-sm font-medium text-gray-700 mb-1">Reason for Leave</label>
            <textarea id="reason" name="reason" rows="3" class="w-full border border-gray-300 rounded-md p-2 focus:ring-indigo-500 focus:border-indigo-500" placeholder="Please provide details about your leave request..."></textarea>
        </div>

        <div>
            <label for="attachment" class="block text-sm font-medium text-gray-700 mb-1">Attachment (if applicable)</label>
            <div class="flex items-center">
                <input type="file" id="attachment" name="attachment" class="hidden">
                <label for="attachment" class="cursor-pointer bg-gray-100 hover:bg-gray-200 text-gray-700 py-2 px-4 rounded-md border border-gray-300 inline-flex items-center transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM6.293 6.707a1 1 0 010-1.414l3-3a1 1 0 011.414 0l3 3a1 1 0 01-1.414 1.414L11 5.414V13a1 1 0 11-2 0V5.414L7.707 6.707a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
                    </svg>
                    Upload File
                </label>
                <span id="fileName" class="ml-3 text-sm text-gray-500">No file selected</span>
            </div>
            <p class="text-xs text-gray-500 mt-1">Upload medical certificates, event invitations, or other supporting documents.</p>
        </div>

        <div class="flex justify-end space-x-3">
            <button type="button" id="cancelButton" class="bg-white border border-gray-300 text-gray-700 py-2 px-4 rounded-md hover:bg-gray-50 transition-colors">
                Cancel
            </button>
            <button type="submit" id="submitButton" class="bg-indigo-600 text-white py-2 px-6 rounded-md hover:bg-indigo-700 transition-colors">
                Submit Request
            </button>
        </div>
    </form>
</div>

<!-- My Leave Requests -->
<div class="border-t border-gray-200 p-4 md:p-6">
    <h3 class="text-lg font-medium text-gray-900 mb-4">My Leave Requests</h3>

    <!-- Pending Leave Request -->
    <div id="request1" class="leave-request border-l-yellow-500 bg-yellow-50 border border-gray-200 rounded-r-md shadow-sm mb-4" data-priority="2" data-status="pending" data-date="2023-05-22">
        <div class="p-4">
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-3">
                <div class="flex items-center mb-2 md:mb-0">
                    <div class="status-icon bg-yellow-100 mr-2">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-yellow-600" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"></path>
                        </svg>
                    </div>
                    <h3 class="font-medium text-gray-900">Vacation Leave</h3>
                </div>
                <div>
                    <span class="status-badge bg-yellow-100 text-yellow-800 text-xs font-medium px-2 py-0.5 rounded-full">Pending</span>
                </div>
            </div>

            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-3">
                <div>
                    <p class="text-xs text-gray-500">Submitted On</p>
                    <p class="text-sm font-medium">May 10, 2023</p>
                </div>
                <div>
                    <p class="text-xs text-gray-500">Duration</p>
                    <p class="text-sm font-medium">5 days</p>
                </div>
                <div>
                    <p class="text-xs text-gray-500">From</p>
                    <p class="text-sm font-medium">May 22, 2023</p>
                </div>
                <div>
                    <p class="text-xs text-gray-500">To</p>
                    <p class="text-sm font-medium">May 26, 2023</p>
                </div>
            </div>

            <div class="mb-3">
                <p class="text-xs text-gray-500">Reason</p>
                <p class="text-sm">Family vacation planned months in advance. All project deliverables will be completed before departure.</p>
            </div>

            <div class="flex justify-end">
                <button onclick="cancelRequest('request1')" class="bg-red-500 hover:bg-red-600 text-white font-medium py-1.5 px-3 text-sm transition-colors rounded-md">
