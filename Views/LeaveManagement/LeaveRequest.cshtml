                </button>
            </div>
        </div>
    </div>

    <!-- Approved Leave Request -->
    <div id="request2" class="leave-request border-l-green-500 bg-green-50 border border-gray-200 rounded-r-md shadow-sm mb-4" data-priority="3" data-status="approved" data-date="2023-04-15">
        <div class="p-4">
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-3">
                <div class="flex items-center mb-2 md:mb-0">
                    <div class="status-icon bg-green-100 mr-2">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-green-600" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                        </svg>
                    </div>
                    <h3 class="font-medium text-gray-900">Sick Leave</h3>
                </div>
                <div>
                    <span class="status-badge bg-green-100 text-green-800 text-xs font-medium px-2 py-0.5 rounded-full">Approved</span>
                </div>
            </div>

            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-3">
                <div>
                    <p class="text-xs text-gray-500">Submitted On</p>
                    <p class="text-sm font-medium">April 14, 2023</p>
                </div>
                <div>
                    <p class="text-xs text-gray-500">Duration</p>
                    <p class="text-sm font-medium">1 day</p>
                </div>
                <div>
                    <p class="text-xs text-gray-500">From</p>
                    <p class="text-sm font-medium">April 15, 2023</p>
                </div>
                <div>
                    <p class="text-xs text-gray-500">To</p>
                    <p class="text-sm font-medium">April 15, 2023</p>
                </div>
            </div>

            <div class="mb-3">
                <p class="text-xs text-gray-500">Reason</p>
                <p class="text-sm">Not feeling well, need to rest and recover. Doctor's note attached.</p>
            </div>

            <div class="flex justify-end">
                <button class="bg-gray-300 text-gray-600 font-medium py-1.5 px-3 text-sm rounded-md cursor-not-allowed" disabled="">
                    Approved
                </button>
            </div>
        </div>
    </div>

    <!-- Rejected Leave Request -->
    <div id="request3" class="leave-request border-l-red-500 bg-red-50 border border-gray-200 rounded-r-md shadow-sm" data-priority="4" data-status="rejected" data-date="2023-03-10">
        <div class="p-4">
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-3">
                <div class="flex items-center mb-2 md:mb-0">
                    <div class="status-icon bg-red-100 mr-2">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-red-600" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path>
                        </svg>
                    </div>
                    <h3 class="font-medium text-gray-900">Personal Leave</h3>
                </div>
                <div>
                    <span class="status-badge bg-red-100 text-red-800 text-xs font-medium px-2 py-0.5 rounded-full">Rejected</span>
                </div>
            </div>

            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-3">
                <div>
                    <p class="text-xs text-gray-500">Submitted On</p>
                    <p class="text-sm font-medium">March 8, 2023</p>
                </div>
                <div>
                    <p class="text-xs text-gray-500">Duration</p>
                    <p class="text-sm font-medium">2 days</p>
                </div>
                <div>
                    <p class="text-xs text-gray-500">From</p>
                    <p class="text-sm font-medium">March 10, 2023</p>
                </div>
                <div>
                    <p class="text-xs text-gray-500">To</p>
                    <p class="text-sm font-medium">March 11, 2023</p>
                </div>
            </div>

            <div class="mb-3">
                <p class="text-xs text-gray-500">Reason</p>
                <p class="text-sm">Need to attend a personal event.</p>
            </div>

            <div class="mb-3">
                <p class="text-xs text-gray-500">Rejection Reason</p>
                <p class="text-sm text-red-700">Critical project deadline on March 11. Please reschedule your leave after the project delivery.</p>
            </div>

            <div class="flex justify-end">
                <button class="bg-gray-300 text-gray-600 font-medium py-1.5 px-3 text-sm rounded-md cursor-not-allowed" disabled="">
                    Rejected
                </button>
            </div>
        </div>
    </div>
</div>

