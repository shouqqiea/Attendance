@model LetsCheckIn.Controllers.LeaveRequestViewModel
@{
    ViewData["Title"] = "Leave Request";
    var leaveTypes = ViewBag.LeaveTypes as List<LetsCheckIn.Controllers.LeaveTypeViewModel>;
    var leaveRequests = ViewBag.LeaveRequests as List<LetsCheckIn.Controllers.LeaveRequestViewModel>;
    var leaveBalances = ViewBag.LeaveBalances as List<LetsCheckIn.Controllers.LeaveBalanceViewModel>;
}

<div class="container mx-auto px-4 py-8">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
<!-- Leave Request Form -->
        <div class="lg:col-span-1">
            <div class="bg-white rounded-lg shadow-md p-6">
                <h2 class="text-2xl font-semibold mb-6 text-gray-800">Submit Leave Request</h2>
                <form id="leaveRequestForm" class="space-y-4">
                    @Html.AntiForgeryToken()
                    
            <div>
                        <label class="block text-sm font-medium text-gray-700">Leave Type</label>
                        <select name="LeaveType" required class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-[#a88641] focus:ring focus:ring-[#a88641] focus:ring-opacity-50">
                    <option value="">Select Leave Type</option>
                            @foreach (var type in leaveTypes)
                            {
                                <option value="@type.LeaveTypeId">@type.Name</option>
                            }
                </select>
                        <div class="leave-type-error text-red-600 text-sm mt-1 hidden"></div>
            </div>

            <div>
                        <label class="block text-sm font-medium text-gray-700">Emergency Request?</label>
                        <select name="Emergency" required class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-[#a88641] focus:ring focus:ring-[#a88641] focus:ring-opacity-50">
                            <option value="no">No</option>
                            <option value="yes">Yes</option>
                        </select>
                        <div class="emergency-error text-red-600 text-sm mt-1 hidden"></div>
                </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700">Start Date</label>
                        <input type="date" name="StartDate" required class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-[#a88641] focus:ring focus:ring-[#a88641] focus:ring-opacity-50">
                        <div class="start-date-error text-red-600 text-sm mt-1 hidden"></div>
        </div>

            <div>
                        <label class="block text-sm font-medium text-gray-700">End Date</label>
                        <input type="date" name="EndDate" required class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-[#a88641] focus:ring focus:ring-[#a88641] focus:ring-opacity-50">
                        <div class="end-date-error text-red-600 text-sm mt-1 hidden"></div>
            </div>

            <div>
                        <label class="block text-sm font-medium text-gray-700">Reason</label>
                        <textarea name="Reason" required rows="3" maxlength="500" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-[#a88641] focus:ring focus:ring-[#a88641] focus:ring-opacity-50"></textarea>
                        <div class="reason-error text-red-600 text-sm mt-1 hidden"></div>
                        <div class="text-sm text-gray-500 mt-1">
                            <span class="char-count">0</span>/500 characters
            </div>
        </div>

        <div>
                        <label class="block text-sm font-medium text-gray-700">Attachment (optional)</label>
                        <input type="file" name="attachment" accept=".pdf,.doc,.docx,.jpg,.jpeg,.png" class="mt-1 block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-[#a88641] file:text-white hover:file:bg-[#97763a]">
                        <div class="text-xs text-gray-500 mt-1">Accepted formats: PDF, DOC, DOCX, JPG, JPEG, PNG</div>
        </div>

                    <div id="formError" class="hidden bg-red-50 border border-red-200 text-red-600 px-4 py-3 rounded-md"></div>

                    <button type="submit" class="w-full bg-[#a88641] text-white py-2 px-4 rounded-md hover:bg-[#97763a] focus:outline-none focus:ring-2 focus:ring-[#a88641] focus:ring-opacity-50 transition-colors flex items-center justify-center">
                        <span class="submit-text">Submit Request</span>
                        <svg class="hidden animate-spin ml-2 h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                    </button>
                </form>
            </div>
        </div>

        <!-- Leave Balances and History -->
        <div class="lg:col-span-2">
            <!-- Leave Balances -->
            <div class="bg-white rounded-lg shadow-md p-6 mb-8">
                <h2 class="text-2xl font-semibold mb-6 text-gray-800">Leave Balances</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                    @foreach (var balance in leaveBalances)
                    {
                        <div class="bg-gray-50 rounded-lg p-4">
                            <h3 class="font-medium text-gray-900">@balance.Type</h3>
                            <div class="mt-2 space-y-1">
                                <p class="text-sm text-gray-600">Total: @balance.Total days</p>
                                <p class="text-sm text-gray-600">Used: @balance.Used days</p>
                                <p class="text-sm font-medium text-gray-900">Remaining: @balance.Remaining days</p>
                </div>
            </div>
                    }
                </div>
            </div>

            <!-- Leave History -->
            <div class="bg-white rounded-lg shadow-md p-6">
                <!-- Pending Requests Section -->
                <div class="mb-8">
                    <h2 class="text-2xl font-semibold text-gray-800 mb-4">Pending Requests</h2>
                    <div id="pendingRequestsContainer" class="space-y-4">
                        @if (leaveRequests.Any(r => r.Status.ToLower() is "pending" or "emergency"))
                        {
                            @foreach (var request in leaveRequests.Where(r => r.Status.ToLower() is "pending" or "emergency"))
                            {
                                <div class="leave-request bg-white rounded-lg p-4 border-l-4 shadow-sm hover:shadow-md transition-all duration-200 ease-in-out @(request.Status.ToLower() switch {
                                    "emergency" => "border-orange-500",
                                    _ => "border-yellow-500"
                                })"
                                     data-date="@string.Format("{0:yyyy-MM-dd}", request.StartDate)"
                                     data-status="@request.Status.ToLower()">
                                    <div class="flex justify-between items-start">
                                        <div>
                                            <h3 class="font-medium text-gray-900 mb-1">@request.LeaveType</h3>
                                            <p class="text-sm text-gray-600 mb-2">@string.Format("{0:MMM d, yyyy}", request.StartDate) - @string.Format("{0:MMM d, yyyy}", request.EndDate)</p>
                                            <p class="text-sm text-gray-500">Duration: @(request.EndDate.HasValue && request.StartDate.HasValue ? (request.EndDate.Value - request.StartDate.Value).Days + 1 : 0) days</p>
                                            <p class="text-sm text-gray-700 bg-gray-50 p-2 rounded-md">@request.Reason</p>
                                            <p class="text-sm text-gray-500 mt-2">Submitted on: @string.Format("{0:MMM d, yyyy}", request.SubmittedOn)</p>
                                            @if (!string.IsNullOrEmpty(request.AttachmentFileName))
                                            {
                                                <a href="@Url.Action("DownloadAttachment", new { id = request.Id })" 
                                                   class="text-sm text-[#a88641] hover:text-[#97763a] mt-2 inline-flex items-center group">
                                                    <svg class="h-4 w-4 mr-1 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                                                    </svg>
                                                    Download Attachment
                                                </a>
                                            }
            </div>
                                        <div class="flex items-center space-x-2">
                                            <span class="px-3 py-1 text-sm font-medium rounded-full shadow-sm @(request.Status.ToLower() switch {
                                                "emergency" => "bg-orange-100 text-orange-800 ring-1 ring-orange-600/20",
                                                _ => "bg-yellow-100 text-yellow-800 ring-1 ring-yellow-600/20"
                                            })">
                                                @request.Status
                                            </span>
                                            <button onclick="cancelLeaveRequest(@request.Id)" 
                                                    class="text-red-600 hover:text-red-800 focus:outline-none p-1 hover:bg-red-50 rounded-full transition-colors">
                                                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                                                </svg>
                </button>
            </div>
        </div>
    </div>
                            }
                        }
                        else
                        {
                            <div class="p-6 text-center">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-gray-400 mx-auto mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                        </svg>
                                <p class="text-gray-500 mb-1">No pending leave requests</p>
                                <p class="text-sm text-gray-400">All leave requests have been processed</p>
                            </div>
                        }
                    </div>
                </div>

                <!-- Leave History Section -->
                <div>
                    <div class="flex justify-between items-center mb-6">
                        <h2 class="text-2xl font-semibold text-gray-800">Leave History</h2>
                        <select id="statusFilter" class="rounded-md border-gray-300 shadow-sm focus:border-[#a88641] focus:ring focus:ring-[#a88641] focus:ring-opacity-50">
                            <option value="all">All Status</option>
                            <option value="approved">Approved</option>
                            <option value="rejected">Rejected</option>
                            <option value="cancelled">Cancelled</option>
                        </select>
            </div>

                    <div id="leaveRequestsContainer">
                        @foreach (var request in leaveRequests.Where(r => r.Status.ToLower() is not "pending" and not "emergency"))
                        {
                            <div class="leave-request mb-4 bg-white rounded-lg p-4 border-l-4 shadow-sm hover:shadow-md transition-all duration-200 ease-in-out @(request.Status.ToLower() switch {
                                "approved" => "border-green-500",
                                "rejected" => "border-red-500",
                                "cancelled" => "border-gray-500",
                                _ => "border-yellow-500"
                            })"
                                 data-date="@string.Format("{0:yyyy-MM-dd}", request.StartDate)"
                                 data-status="@request.Status.ToLower()">
                                <div class="flex justify-between items-start">
                <div>
                                        <h3 class="font-medium text-gray-900 mb-1">@request.LeaveType</h3>
                                        <p class="text-sm text-gray-600 mb-2">@string.Format("{0:MMM d, yyyy}", request.StartDate) - @string.Format("{0:MMM d, yyyy}", request.EndDate)</p>
                                        <p class="text-sm text-gray-500">Duration: @(request.EndDate.HasValue && request.StartDate.HasValue ? (request.EndDate.Value - request.StartDate.Value).Days + 1 : 0) days</p>
                                        <p class="text-sm text-gray-700 bg-gray-50 p-2 rounded-md">@request.Reason</p>
                                        <p class="text-sm text-gray-500 mt-2">Submitted on: @string.Format("{0:MMM d, yyyy}", request.SubmittedOn)</p>
                                        @if (!string.IsNullOrEmpty(request.RejectionReason))
                                        {
                                            <p class="text-sm text-red-600 mt-2 bg-red-50 p-2 rounded-md">Rejection Reason: @request.RejectionReason</p>
                                        }
                                        @if (!string.IsNullOrEmpty(request.AttachmentFileName))
                                        {
                                            <a href="@Url.Action("DownloadAttachment", new { id = request.Id })" 
                                               class="text-sm text-[#a88641] hover:text-[#97763a] mt-2 inline-flex items-center group">
                                                <svg class="h-4 w-4 mr-1 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                                                </svg>
                                                Download Attachment
                                            </a>
                                        }
                </div>
                                    <div class="flex items-center space-x-2">
                                        <span class="px-3 py-1 text-sm font-medium rounded-full shadow-sm @(request.Status.ToLower() switch {
                                            "approved" => "bg-green-100 text-green-800 ring-1 ring-green-600/20",
                                            "rejected" => "bg-red-100 text-red-800 ring-1 ring-red-600/20",
                                            "cancelled" => "bg-gray-100 text-gray-800 ring-1 ring-gray-600/20",
                                            _ => "bg-yellow-100 text-yellow-800 ring-1 ring-yellow-600/20"
                                        })">
                                            @request.Status
                                        </span>
            </div>
        </div>
    </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Cancel Leave Request Confirmation Modal -->
<div id="cancelLeaveModal" class="fixed inset-0 bg-gray-600 bg-opacity-50 hidden items-center justify-center z-50">
    <div class="bg-white rounded-lg p-6 max-w-sm mx-4 w-full transform transition-all">
        <div class="flex items-center justify-between mb-4">
            <h3 class="text-lg font-medium text-gray-900">Confirm Cancellation</h3>
            <button onclick="closeCancelModal()" class="text-gray-400 hover:text-gray-500">
                <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>
        <div class="mb-6">
            <p class="text-sm text-gray-600">Are you sure you want to cancel this leave request? This action cannot be undone.</p>
        </div>
        <input type="hidden" id="leaveRequestIdToCancel" />
        <div class="flex flex-col sm:flex-row justify-end gap-2 sm:gap-3">
            <button type="button" onclick="closeCancelModal()" 
                    class="w-full sm:w-auto px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md shadow-sm hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#a88641]">
                Cancel
            </button>
            <button type="button" onclick="confirmCancelLeaveRequest()" 
                    class="w-full sm:w-auto px-4 py-2 text-sm font-medium text-white bg-red-600 border border-transparent rounded-md shadow-sm hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500">
                Cancel Leave Request
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/leave-request-sorting.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const form = document.getElementById('leaveRequestForm');
            const submitButton = form.querySelector('button[type="submit"]');
            const submitText = submitButton.querySelector('.submit-text');
            const spinner = submitButton.querySelector('svg');
            const formError = document.getElementById('formError');
            
            // Character count for reason textarea
            const reasonTextarea = form.querySelector('textarea[name="Reason"]');
            const charCount = form.querySelector('.char-count');
            
            reasonTextarea.addEventListener('input', function() {
                const count = this.value.length;
                charCount.textContent = count;
                if (count > 500) {
                    this.value = this.value.substring(0, 500);
                    charCount.textContent = '500';
                }
            });

            // Date validation
            const startDateInput = form.querySelector('input[name="StartDate"]');
            const endDateInput = form.querySelector('input[name="EndDate"]');
            
            startDateInput.addEventListener('change', validateDates);
            endDateInput.addEventListener('change', validateDates);
            
            function validateDates() {
                const startDate = new Date(startDateInput.value);
                const endDate = new Date(endDateInput.value);
                const startDateError = form.querySelector('.start-date-error');
                const endDateError = form.querySelector('.end-date-error');
                
                startDateError.classList.add('hidden');
                endDateError.classList.add('hidden');
                
                if (!startDateInput.value) {
                    startDateError.textContent = 'Start date is required';
                    startDateError.classList.remove('hidden');
                    return false;
                }
                
                if (!endDateInput.value) {
                    endDateError.textContent = 'End date is required';
                    endDateError.classList.remove('hidden');
                    return false;
                }
                
                if (startDate > endDate) {
                    endDateError.textContent = 'End date must be after start date';
                    endDateError.classList.remove('hidden');
                    return false;
                }
                
                return true;
            }

            form.addEventListener('submit', async function(e) {
                e.preventDefault();
                
                // Reset error states
                formError.classList.add('hidden');
                form.querySelectorAll('.text-red-600').forEach(el => el.classList.add('hidden'));
                
                // Validate form
                if (!form.checkValidity()) {
                    form.reportValidity();
                    return;
                }
                
                if (!validateDates()) {
                    return;
                }
                
                // Show loading state
                submitButton.disabled = true;
                submitText.textContent = 'Submitting...';
                spinner.classList.remove('hidden');
                
                const formData = new FormData(this);
                
                try {
                    const response = await fetch('@Url.Action("LeaveRequest")', {
                        method: 'POST',
                        body: formData
                    });
                    
                    const result = await response.json();
                    
                    if (result.success) {
                        // Show success message
                        formError.classList.remove('hidden');
                        formError.classList.remove('bg-red-50', 'border-red-200', 'text-red-600');
                        formError.classList.add('bg-green-50', 'border-green-200', 'text-green-600');
                        formError.textContent = result.message;
                        
                        // Reset form
                        form.reset();
                        charCount.textContent = '0';
                        
                        // Reload page after 2 seconds
                        setTimeout(() => location.reload(), 2000);
                    } else {
                        // Show error message
                        formError.classList.remove('hidden');
                        formError.textContent = result.message || 'Failed to submit request';
                        
                        // Handle validation errors
                        if (result.errors && Array.isArray(result.errors)) {
                            // Clear previous errors
                            form.querySelectorAll('.text-red-600').forEach(el => el.classList.add('hidden'));
                            
                            // Display each error
                            result.errors.forEach(error => {
                                // Try to match the error to a specific field
                                const fieldMatch = error.toLowerCase().match(/^([a-z]+)/);
                                if (fieldMatch) {
                                    const field = fieldMatch[1];
                                    const errorElement = form.querySelector(`.${field}-error`);
                                    if (errorElement) {
                                        errorElement.textContent = error;
                                        errorElement.classList.remove('hidden');
                                    }
                                }
                            });
                        }

                        // Handle model state errors
                        if (result.modelState) {
                            Object.entries(result.modelState).forEach(([field, errors]) => {
                                const errorElement = form.querySelector(`.${field.toLowerCase()}-error`);
                                if (errorElement && errors.length > 0) {
                                    errorElement.textContent = errors[0];
                                    errorElement.classList.remove('hidden');
                                }
                            });
                        }

                        // Log the full error response for debugging
                        console.log('Validation errors:', result);
                    }
                } catch (error) {
                    console.error('Error:', error);
                    formError.classList.remove('hidden');
                    formError.textContent = 'An error occurred while submitting the request.';
                } finally {
                    // Reset button state
                    submitButton.disabled = false;
                    submitText.textContent = 'Submit Request';
                    spinner.classList.add('hidden');
                }
            });
        });

        // Update the cancelLeaveRequest function
        window.cancelLeaveRequest = function(id) {
            document.getElementById('leaveRequestIdToCancel').value = id;
            const modal = document.getElementById('cancelLeaveModal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeCancelModal() {
            const modal = document.getElementById('cancelLeaveModal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
            document.getElementById('leaveRequestIdToCancel').value = '';
        }

        async function confirmCancelLeaveRequest() {
            const id = document.getElementById('leaveRequestIdToCancel').value;
            const tokenElement = document.querySelector('input[name="__RequestVerificationToken"]');
            
            try {
                const response = await fetch('@Url.Action("CancelLeaveRequest")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': tokenElement.value
                    },
                    body: JSON.stringify(id)
                });
                
                const result = await response.json();
                
                if (result.success) {
                    showNotification('success', result.message);
                    setTimeout(() => {
                        location.reload();
                    }, 1500);
                } else {
                    showNotification('error', result.message);
                }
                closeCancelModal();
            } catch (error) {
                console.error('Error:', error);
                showNotification('error', 'An error occurred while cancelling the request.');
                closeCancelModal();
            }
        }

        function showNotification(type, message) {
            const container = document.getElementById('notificationContainer');
            const notification = document.createElement('div');
            notification.className = `p-4 mb-4 rounded-md ${type === 'success' ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800'}`;
            notification.innerHTML = message;
            
            container.appendChild(notification);
            
            setTimeout(() => {
                notification.remove();
            }, 5000);
        }
    </script>
}