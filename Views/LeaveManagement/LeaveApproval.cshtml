@{
    ViewBag.Title = "Leave Approval";
    var pendingRequests = ViewBag.PendingRequests as List<LetsCheckIn.Controllers.LeaveRequestViewModel>;
}

<div class="min-h-screen bg-gray-50">
    <!-- Notification Container -->
    <div id="notificationContainer" class="fixed top-4 right-4 z-50 w-full max-w-xs"></div>
    
    <!-- Main Content Area -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 sm:py-8">
        <!-- Header Section -->
        <div class="mb-6 sm:mb-8">
            <div class="text-center md:text-left">
                <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-2">Leave Management</h1>
                <p class="text-sm sm:text-base text-gray-600">Review and manage employee leave requests with enhanced controls</p>
            </div>
        </div>

        <!-- Pending Requests Section -->
        <div class="bg-white rounded-xl shadow-lg border border-gray-200 overflow-hidden mb-6 sm:mb-8">
            <!-- Enhanced Header -->
            <div class="px-6 py-5 bg-gradient-to-r from-gray-50 to-gray-100 border-b border-gray-200">
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
                    <div class="flex items-center">
                        <div class="w-10 h-10 bg-amber-500 rounded-xl flex items-center justify-center mr-3 shadow-md">
                            <svg class="h-6 w-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                            </svg>
                        </div>
                        <div>
                            <h2 class="text-xl font-bold text-gray-900">Pending Requests</h2>
                            <p class="text-sm text-gray-600 mt-1">Requests awaiting your approval</p>
                        </div>
                    </div>
                    <div class="flex flex-col lg:flex-row gap-4 w-full lg:w-auto">
                        
                        <!-- Card Controls (show only in cards view) -->
                        <div id="pendingCardControls" class="flex items-center space-x-2">
                            <button id="collapseAllPendingBtn" onclick="collapseAllPending()" 
                                    class="flex items-center px-3 py-1.5 text-sm font-medium text-gray-600 hover:text-gray-900 bg-gray-50 hover:bg-gray-100 rounded-lg transition-all duration-200">
                                <svg class="h-4 w-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7-7m0 0l-7 7m7-7v18"/>
                                </svg>
                                Collapse All
                            </button>
                            <button id="expandAllPendingBtn" onclick="expandAllPending()" 
                                    class="flex items-center px-3 py-1.5 text-sm font-medium text-gray-600 hover:text-gray-900 bg-gray-50 hover:bg-gray-100 rounded-lg transition-all duration-200">
                                <svg class="h-4 w-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7 7m0 0l7-7m-7 7V3"/>
                                </svg>
                                Expand All
                            </button>
                        </div>
                        
                        <!-- Search and Filter -->
                        <div class="flex flex-col sm:flex-row gap-3">
                            <div class="relative">
                                <input type="text" 
                                       id="pendingSearch" 
                                       placeholder="Search by employee, type, or reason..." 
                                       class="block w-full sm:w-64 px-4 py-3 bg-gray-50 border border-gray-200 rounded-lg focus:ring-2 focus:ring-[#a88641] focus:border-[#a88641] focus:bg-white transition-all duration-200 text-gray-900 sm:text-sm">
                                <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none">
                                    <svg class="h-5 w-5 text-gray-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                                        <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd" />
                                    </svg>
                                </div>
                            </div>
                            <div class="relative">
                                <select id="pendingStatusFilter" 
                                        class="block w-full sm:w-48 px-4 py-3 bg-gray-50 border border-gray-200 rounded-lg focus:ring-2 focus:ring-[#a88641] focus:border-[#a88641] focus:bg-white transition-all duration-200 appearance-none text-gray-900 sm:text-sm">
                                    <option value="all">All Status</option>
                                    <option value="pending">Pending</option>
                                    <option value="emergency">Emergency</option>
                                </select>
                                <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none">
                                    <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                                    </svg>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="divide-y divide-gray-200">
                @if (pendingRequests != null && pendingRequests.Any(r => r.Status.ToLower() == "pending" || r.Status.ToLower() == "emergency"))
                {
                    foreach (var request in pendingRequests.Where(r => r.Status.ToLower() == "pending" || r.Status.ToLower() == "emergency"))
                    {
                        var isEmergency = request.Status == "emergency" || request.Emergency == "yes";
                        var borderClass = isEmergency ? "border-l-4 border-red-500" : "border-l-4 border-yellow-500";
                        var statusText = isEmergency ? "Emergency" : "Pending";
                        var statusBadgeClass = isEmergency
                            ? "bg-red-100 text-red-800"
                            : "bg-yellow-100 text-yellow-800";
                        var duration = (request.EndDate - request.StartDate)?.Days + 1 ?? 1;

                        <div class="pending-request bg-gradient-to-r from-white to-gray-50 rounded-lg border-l-4 shadow-sm hover:shadow-lg transition-all duration-300 ease-in-out transform hover:scale-[1.02] @(request.Status.ToLower() switch {
                            "approved" => "border-green-500 hover:border-green-600",
                            "rejected" => "border-red-500 hover:border-red-600",
                            "cancelled" => "border-gray-500 hover:border-gray-600",
                            "emergency" => "border-red-500 hover:border-red-600",
                            _ => "border-yellow-500 hover:border-yellow-600"
                        })" 
                             data-status="@(isEmergency ? "emergency" : "pending")">
                            
                            <!-- Card Header (Always visible) -->
                            <div class="p-6 cursor-pointer" onclick="toggleCard(this.parentElement)">
                                <div class="flex flex-col md:flex-row md:items-center md:justify-between">
                                    <!-- Employee Info Summary -->
                                    <div class="flex items-center space-x-4 mb-2 md:mb-0">
                                        <div class="flex-shrink-0">
                                            <div class="h-12 w-12 rounded-full bg-gradient-to-br from-gray-200 to-gray-300 flex items-center justify-center shadow-md">
                                                <span class="text-lg font-bold text-gray-700">
                                                    @request.EmployeeName.Substring(0, 1)
                                                </span>
                                            </div>
                                        </div>
                                        <div>
                                            <h3 class="text-lg font-semibold text-gray-900 employee-name flex items-center">
                                                <svg class="h-5 w-5 mr-2 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                                                </svg>
                                                @request.EmployeeName
                                            </h3>
                                            <p class="text-sm text-gray-600 employee-email">@request.EmployeeEmail</p>
                                            <p class="text-sm text-gray-500 mt-1">@request.LeaveType • @request.StartDate?.ToString("MMM dd") - @request.EndDate?.ToString("MMM dd, yyyy") • @duration days</p>
                                        </div>
                                    </div>
                                    
                                    <!-- Status & Toggle -->
                                    <div class="flex items-center space-x-3">
                                        @if (isEmergency)
                                        {
                                            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-red-100 text-red-800 ring-1 ring-red-600/20 shadow-sm">
                                                <svg class="h-4 w-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z"/>
                                                </svg>
                                                Emergency
                                            </span>
                                        }
                                        <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium @statusBadgeClass ring-1 ring-yellow-600/20 shadow-sm">
                                            <svg class="h-4 w-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                            </svg>
                                            @statusText
                                        </span>
                                        <button class="card-toggle-btn p-1 hover:bg-gray-100 rounded-full transition-colors duration-200" onclick="event.stopPropagation(); toggleCard(this.closest('.pending-request'))">
                                            <svg class="h-5 w-5 text-gray-500 transform transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                                            </svg>
                                        </button>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Card Details (Collapsible) -->
                            <div class="card-details px-6 pb-6 space-y-4">
                                <!-- Leave Details -->
                                <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-4 mb-4">
                                    <div class="bg-blue-50 p-4 rounded-lg border border-blue-200">
                                        <p class="text-sm font-semibold text-blue-700 flex items-center">
                                            <svg class="h-4 w-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a1.994 1.994 0 01-1.414.586H7a4 4 0 01-4-4V7a4 4 0 014-4z"/>
                                            </svg>
                                            Leave Type
                                        </p>
                                        <p class="mt-2 text-lg font-bold text-blue-900 leave-type">@request.LeaveType</p>
                                    </div>
                                    <div class="bg-green-50 p-4 rounded-lg border border-green-200">
                                        <p class="text-sm font-semibold text-green-700 flex items-center">
                                            <svg class="h-4 w-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                            </svg>
                                            Duration
                                        </p>
                                        <p class="mt-2 text-lg font-bold text-green-900">@duration @(duration == 1 ? "day" : "days")</p>
                                    </div>
                                    <div class="bg-indigo-50 p-4 rounded-lg border border-indigo-200">
                                        <p class="text-sm font-semibold text-indigo-700 flex items-center">
                                            <svg class="h-4 w-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                                            </svg>
                                            Start Date
                                        </p>
                                        <p class="mt-2 text-lg font-bold text-indigo-900">@request.StartDate?.ToString("MMM dd, yyyy")</p>
                                    </div>
                                    <div class="bg-purple-50 p-4 rounded-lg border border-purple-200">
                                        <p class="text-sm font-semibold text-purple-700 flex items-center">
                                            <svg class="h-4 w-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                                            </svg>
                                            End Date
                                        </p>
                                        <p class="mt-2 text-lg font-bold text-purple-900">@request.EndDate?.ToString("MMM dd, yyyy")</p>
                                    </div>
                                </div>

                                <!-- Reason -->
                                <div class="mb-4 bg-gray-50 border border-gray-200 rounded-lg p-4">
                                    <p class="text-sm font-semibold text-gray-700 mb-2 flex items-center">
                                        <svg class="h-4 w-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                                        </svg>
                                        Reason for Leave
                                    </p>
                                    <p class="text-sm text-gray-900 leading-relaxed leave-reason">@request.Reason</p>
                                </div>

                                <!-- Attachment -->
                                @if (!string.IsNullOrEmpty(request.AttachmentFileName))
                                {
                                    <div class="mb-6">
                                        <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-3">
                                            <a href="/LeaveManagement/DownloadAttachment/@request.Id" 
                                               class="inline-flex items-center text-sm text-[#a88641] hover:text-[#916f34] font-medium group transition-colors">
                                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2 group-hover:scale-110 transition-transform" viewBox="0 0 20 20" fill="currentColor">
                                                    <path fill-rule="evenodd" d="M8 4a3 3 0 00-3 3v4a5 5 0 0010 0V7a1 1 0 112 0v4a7 7 0 11-14 0V7a5 5 0 0110 0v4a3 3 0 11-6 0V7a1 1 0 012 0v4a1 1 0 102 0V7a3 3 0 00-3-3z" clip-rule="evenodd" />
                                                </svg>
                                                Download Supporting Document
                                            </a>
                                        </div>
                                    </div>
                                }

                                <!-- Action Buttons -->
                                <div class="flex flex-col sm:flex-row gap-3">
                                    <button onclick="approveRequest(@request.Id)" 
                                            class="flex-1 inline-flex justify-center items-center px-6 py-3 border border-transparent text-sm font-semibold rounded-lg text-white bg-gradient-to-r from-green-600 to-green-700 hover:from-green-700 hover:to-green-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500 transition-all duration-200 transform hover:scale-[1.02] active:scale-[0.98] shadow-md hover:shadow-lg group">
                                        <svg class="h-5 w-5 mr-2 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                        </svg>
                                        Approve Request
                                    </button>
                                    <button onclick="showRejectionInput(@request.Id)" 
                                            class="flex-1 inline-flex justify-center items-center px-6 py-3 border border-transparent text-sm font-semibold rounded-lg text-white bg-gradient-to-r from-red-600 to-red-700 hover:from-red-700 hover:to-red-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 transition-all duration-200 transform hover:scale-[1.02] active:scale-[0.98] shadow-md hover:shadow-lg group">
                                        <svg class="h-5 w-5 mr-2 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                                        </svg>
                                        Reject Request
                                    </button>
                                </div>

                                <!-- Rejection Form (Hidden by default) -->
                                <div id="rejectionForm@(request.Id)" class="mt-6 hidden">
                                    <div class="bg-red-50 border-2 border-red-200 rounded-xl p-5 transition-all duration-300">
                                        <div class="flex items-center mb-4">
                                            <svg class="h-6 w-6 text-red-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z"/>
                                            </svg>
                                            <h4 class="text-lg font-semibold text-red-800">Provide Rejection Reason</h4>
                                        </div>
                                        <form onsubmit="rejectRequest(@request.Id, event)" class="space-y-4">
                                            @Html.AntiForgeryToken()
                                            <div>
                                                <label for="rejectionReason@(request.Id)" class="block text-sm font-semibold text-red-700 mb-2">
                                                    Why are you rejecting this request?
                                                </label>
                                                <textarea id="rejectionReason@(request.Id)" 
                                                          name="rejectionReason" 
                                                          rows="4" 
                                                          maxlength="500"
                                                          class="block w-full px-4 py-3 bg-white border border-red-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-red-500 transition-all duration-200 resize-none text-gray-900 sm:text-sm"
                                                          placeholder="Please provide a clear and detailed reason for rejecting this leave request..."
                                                          required></textarea>
                                                <div class="flex justify-between items-center text-xs text-red-600 mt-1">
                                                    <span>Be specific and professional in your feedback</span>
                                                    <span><span class="char-count">0</span>/500</span>
                                                </div>
                                            </div>
                                            <div class="flex flex-col sm:flex-row justify-end space-y-2 sm:space-y-0 sm:space-x-3 pt-2">
                                                <button type="button" 
                                                        onclick="hideRejectionInput(@request.Id)"
                                                        class="inline-flex justify-center items-center px-6 py-3 border border-gray-300 text-sm font-semibold rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#a88641] transition-all duration-200 shadow-md hover:shadow-lg">
                                                    <svg class="h-4 w-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                                                    </svg>
                                                    Cancel
                                                </button>
                                                <button type="submit"
                                                        class="inline-flex justify-center items-center px-6 py-3 border border-transparent text-sm font-semibold rounded-lg text-white bg-gradient-to-r from-red-600 to-red-700 hover:from-red-700 hover:to-red-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 transition-all duration-200 transform hover:scale-[1.02] active:scale-[0.98] shadow-md hover:shadow-lg">
                                                    <svg class="h-4 w-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z"/>
                                                    </svg>
                                                    Confirm Rejection
                                                </button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="p-6 text-center">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-gray-400 mx-auto mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                        </svg>
                        <p class="text-gray-500 mb-1">No pending leave requests</p>
                        <p class="text-sm text-gray-400">All leave requests have been processed</p>
                    </div>
                }
            </div>
        </div>

        <!-- History Section -->
        <div class="bg-white rounded-xl shadow-lg border border-gray-200 overflow-hidden">
            <!-- Enhanced History Header -->
            <div class="px-6 py-5 bg-gradient-to-r from-gray-50 to-gray-100 border-b border-gray-200">
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
                    <div class="flex items-center">
                        <div class="w-10 h-10 bg-blue-500 rounded-xl flex items-center justify-center mr-3 shadow-md">
                            <svg class="h-6 w-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                            </svg>
                        </div>
                        <div>
                            <h2 class="text-xl font-bold text-gray-900">Leave History</h2>
                            <p class="text-sm text-gray-600 mt-1">Previously processed leave requests</p>
                        </div>
                    </div>
                    <div class="flex flex-col lg:flex-row gap-4 w-full lg:w-auto">
                        
                        <!-- Group Controls (show only in grouped view) -->
                        <div id="historyGroupControls" class="flex items-center space-x-2">
                            <button id="collapseAllHistoryGroupsBtn" onclick="collapseAllHistoryGroups()" 
                                    class="flex items-center px-3 py-1.5 text-sm font-medium text-gray-600 hover:text-gray-900 bg-gray-50 hover:bg-gray-100 rounded-lg transition-all duration-200">
                                <svg class="h-4 w-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"/>
                                </svg>
                                Collapse All
                            </button>
                            <button id="expandAllHistoryGroupsBtn" onclick="expandAllHistoryGroups()" 
                                    class="flex items-center px-3 py-1.5 text-sm font-medium text-gray-600 hover:text-gray-900 bg-gray-50 hover:bg-gray-100 rounded-lg transition-all duration-200">
                                <svg class="h-4 w-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                                </svg>
                                Expand All
                            </button>
                        </div>
                        
                        <!-- Search and Filter -->
                        <div class="flex flex-col sm:flex-row gap-3">
                            <div class="relative">
                                <input type="text" 
                                       id="historySearch" 
                                       placeholder="Search by employee, type, or status..." 
                                       class="block w-full sm:w-64 px-4 py-3 bg-gray-50 border border-gray-200 rounded-lg focus:ring-2 focus:ring-[#a88641] focus:border-[#a88641] focus:bg-white transition-all duration-200 text-gray-900 sm:text-sm">
                                <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none">
                                    <svg class="h-5 w-5 text-gray-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                                        <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd" />
                                    </svg>
                                </div>
                            </div>
                            <div class="relative">
                                <select id="historyStatusFilter" 
                                        class="block w-full sm:w-48 px-4 py-3 bg-gray-50 border border-gray-200 rounded-lg focus:ring-2 focus:ring-[#a88641] focus:border-[#a88641] focus:bg-white transition-all duration-200 appearance-none text-gray-900 sm:text-sm">
                                    <option value="all">All Status</option>
                                    <option value="approved">Approved</option>
                                    <option value="rejected">Rejected</option>
                                    <option value="cancelled">Cancelled</option>
                                </select>
                                <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none">
                                    <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                                    </svg>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div id="historyContainer" class="divide-y divide-gray-200 max-h-[600px] overflow-y-auto">
                @{
                    var historyRequests = pendingRequests?.Where(r => r.Status != "pending" && r.Status != "emergency").ToList() 
                        ?? new List<LetsCheckIn.Controllers.LeaveRequestViewModel>();
                }

                @if (historyRequests.Any())
                {
                    foreach (var request in historyRequests)
                    {
                        var statusClass = request.Status.ToLower() switch
                        {
                            "approved" => "bg-green-100 text-green-800",
                            "rejected" => "bg-red-100 text-red-800",
                            "cancelled" => "bg-gray-100 text-gray-800",
                            _ => "bg-yellow-100 text-yellow-800"
                        };

                        <div class="leave-history-item bg-gradient-to-r from-white to-gray-50 rounded-lg border-l-4 shadow-sm hover:shadow-lg transition-all duration-300 ease-in-out transform hover:scale-[1.01] @(request.Status.ToLower() switch {
                            "approved" => "border-green-500 hover:border-green-600",
                            "rejected" => "border-red-500 hover:border-red-600",
                            "cancelled" => "border-gray-500 hover:border-gray-600",
                            _ => "border-yellow-500 hover:border-yellow-600"
                        })" 
                             data-status="@request.Status.ToLower()"
                             data-date="@request.StartDate?.ToString("yyyy-MM-dd")">
                            
                            <!-- Card Header (Always visible) -->
                            <div class="p-6 cursor-pointer" onclick="toggleCard(this.parentElement)">
                                <div class="flex flex-col md:flex-row md:items-center md:justify-between">
                                    <!-- Employee Info Summary -->
                                    <div class="flex items-center space-x-4 mb-2 md:mb-0">
                                        <div class="flex-shrink-0">
                                            <div class="h-12 w-12 rounded-full bg-gradient-to-br from-gray-200 to-gray-300 flex items-center justify-center shadow-md">
                                                <span class="text-lg font-bold text-gray-700">
                                                    @request.EmployeeName.Substring(0, 1)
                                                </span>
                                            </div>
                                        </div>
                                        <div>
                                            <h3 class="text-lg font-semibold text-gray-900 employee-name flex items-center">
                                                <svg class="h-5 w-5 mr-2 @(request.Status.ToLower() switch {
                                                    "approved" => "text-green-600",
                                                    "rejected" => "text-red-600", 
                                                    "cancelled" => "text-gray-600",
                                                    _ => "text-blue-600"
                                                })" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                                                </svg>
                                                @request.EmployeeName
                                            </h3>
                                            <p class="text-sm text-gray-600 employee-email">@request.EmployeeEmail</p>
                                            <p class="text-sm text-gray-500 mt-1">@request.LeaveType • @request.StartDate?.ToString("MMM dd") - @request.EndDate?.ToString("MMM dd, yyyy") • @((request.EndDate - request.StartDate)?.Days + 1 ?? 0) days</p>
                                        </div>
                                    </div>
                                    
                                    <!-- Status & Toggle -->
                                    <div class="flex items-center space-x-3">
                                        <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium @statusClass ring-1 @(request.Status.ToLower() switch {
                                            "approved" => "ring-green-600/20",
                                            "rejected" => "ring-red-600/20",
                                            "cancelled" => "ring-gray-600/20",
                                            _ => "ring-yellow-600/20"
                                        }) shadow-sm">
                                            <svg class="h-4 w-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                @if (request.Status.ToLower() == "approved")
                                                {
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                                }
                                                else if (request.Status.ToLower() == "rejected")
                                                {
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                                                }
                                                else if (request.Status.ToLower() == "cancelled")
                                                {
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1-1H8a1 1 0 00-1 1v3M4 7h16"/>
                                                }
                                                else
                                                {
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                                }
                                            </svg>
                                            @request.Status
                                        </span>
                                        <button class="card-toggle-btn p-1 hover:bg-gray-100 rounded-full transition-colors duration-200" onclick="event.stopPropagation(); toggleCard(this.closest('.leave-history-item'))">
                                            <svg class="h-5 w-5 text-gray-500 transform transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                                            </svg>
                                        </button>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Card Details (Collapsible) -->
                            <div class="card-details px-6 pb-6 space-y-4">
                                <!-- Leave Details -->
                                <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-4 mb-4">
                                    <div class="bg-blue-50 p-4 rounded-lg border border-blue-200">
                                        <p class="text-sm font-medium text-gray-500">Leave Type</p>
                                        <p class="mt-1 text-sm text-gray-900 leave-type">@request.LeaveType</p>
                                    </div>
                                    <div class="bg-green-50 p-4 rounded-lg border border-green-200">
                                        <p class="text-sm font-medium text-gray-500">Duration</p>
                                        <p class="mt-1 text-sm text-gray-900">@((request.EndDate - request.StartDate)?.Days + 1 ?? 0) days</p>
                                    </div>
                                    <div class="bg-indigo-50 p-4 rounded-lg border border-indigo-200">
                                        <p class="text-sm font-medium text-gray-500">Start Date</p>
                                        <p class="mt-1 text-sm text-gray-900">@request.StartDate?.ToString("MMM dd, yyyy")</p>
                                    </div>
                                    <div class="bg-purple-50 p-4 rounded-lg border border-purple-200">
                                        <p class="text-sm font-medium text-gray-500">End Date</p>
                                        <p class="mt-1 text-sm text-gray-900">@request.EndDate?.ToString("MMM dd, yyyy")</p>
                                    </div>
                                </div>

                                <!-- Reason -->
                                <div class="mb-4">
                                    <p class="text-sm font-medium text-gray-500">Reason</p>
                                    <p class="mt-1 text-sm text-gray-900 leave-reason">@request.Reason</p>
                                </div>

                                @if (!string.IsNullOrEmpty(request.RejectionReason))
                                {
                                    <div class="mb-4">
                                        <p class="text-sm font-medium text-gray-500">Rejection Reason</p>
                                        <p class="mt-1 text-sm text-red-600 bg-red-50 p-3 rounded-md border border-red-100">@request.RejectionReason</p>
                                    </div>
                                }

                                <!-- Action Tracking Information -->
                                @if (!string.IsNullOrEmpty(request.ActionPerformedBy) && request.ActionPerformedOn.HasValue)
                                {
                                    <div class="mb-4">
                                        <div class="bg-gray-50 p-4 rounded-lg border border-gray-200">
                                            <div class="flex items-center space-x-3">
                                                <div class="flex-shrink-0">
                                                    <svg class="h-5 w-5 @(request.Status.ToLower() == "approved" ? "text-green-600" : "text-red-600")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        @if (request.Status.ToLower() == "approved")
                                                        {
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                                        }
                                                        else
                                                        {
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                                                        }
                                                    </svg>
                                                </div>
                                                <div class="flex-1">
                                                    <p class="text-sm font-medium text-gray-900">
                                                        @(request.Status.ToLower() == "approved" ? "Approved" : request.Status.ToLower() == "rejected" ? "Rejected" : "Processed") by @request.ActionPerformedBy
                                                    </p>
                                                    <p class="text-sm text-gray-500">
                                                        @request.ActionPerformedOn?.ToString("MMM dd, yyyy 'at' hh:mm tt")
                                                    </p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }

                                @if (!string.IsNullOrEmpty(request.AttachmentFileName))
                                {
                                    <div>
                                        <a href="/LeaveManagement/DownloadAttachment/@request.Id" 
                                           class="inline-flex items-center text-sm text-[#a88641] hover:text-[#916f34]">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" viewBox="0 0 20 20" fill="currentColor">
                                                <path fill-rule="evenodd" d="M8 4a3 3 0 00-3 3v4a5 5 0 0010 0V7a1 1 0 112 0v4a7 7 0 11-14 0V7a5 5 0 0110 0v4a3 3 0 11-6 0V7a1 1 0 012 0v4a1 1 0 102 0V7a3 3 0 00-3-3z" clip-rule="evenodd" />
                                            </svg>
                                            Download Attachment
                                        </a>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="p-6 text-center">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-gray-400 mx-auto mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                        </svg>
                        <p class="text-gray-500 mb-1">No leave history found</p>
                        <p class="text-sm text-gray-400">There are no processed leave requests</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Approval Confirmation Modal -->
<div id="approvalConfirmModal" class="fixed inset-0 z-50 hidden">
    <!-- Modal Backdrop -->
    <div class="fixed inset-0 bg-black bg-opacity-50 transition-opacity"></div>
    
    <!-- Modal Content -->
    <div class="fixed inset-0 flex items-center justify-center p-4">
        <div class="bg-white rounded-xl shadow-xl max-w-md w-full mx-auto transform transition-all">
            <!-- Modal Header -->
            <div class="px-6 py-4 border-b border-gray-200">
                <div class="flex items-center justify-between">
                    <h3 class="text-lg font-semibold text-gray-900 flex items-center">
                        <svg class="h-6 w-6 text-green-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                        Confirm Approval
                    </h3>
                    <button onclick="closeApprovalConfirmModal()" class="text-gray-400 hover:text-gray-600 transition-colors">
                        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                    </button>
                </div>
            </div>
            
            <!-- Modal Body -->
            <div class="px-6 py-4">
                <div class="flex items-start space-x-3">
                    <div class="flex-shrink-0">
                        <svg class="h-8 w-8 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                    </div>
                    <div class="flex-1">
                        <p class="text-sm text-gray-600 mb-3">
                            Are you sure you want to approve this leave request? This will grant the employee the requested time off.
                        </p>
                        <div class="bg-green-50 border border-green-200 rounded-md p-3">
                            <p class="text-xs text-green-700">
                                <strong>Note:</strong> Once approved, the employee will be notified and this action cannot be undone.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Modal Footer -->
            <div class="px-6 py-4 bg-gray-50 flex justify-end space-x-3 rounded-b-xl">
                <input type="hidden" id="approvalRequestId" />
                <button type="button" onclick="closeApprovalConfirmModal()" 
                        class="px-6 py-3 text-sm font-semibold text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#a88641] transition-colors shadow-md hover:shadow-lg">
                    Cancel
                </button>
                <button type="button" onclick="confirmApproveRequest()" 
                        class="px-6 py-3 text-sm font-semibold text-white bg-gradient-to-r from-green-600 to-green-700 hover:from-green-700 hover:to-green-800 border border-transparent rounded-lg focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500 transition-all duration-200 transform hover:scale-[1.02] active:scale-[0.98] shadow-md hover:shadow-lg">
                    <span class="flex items-center">
                        <svg class="h-4 w-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                        Confirm Approval
                    </span>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Rejection Confirmation Modal -->
<div id="rejectionConfirmModal" class="fixed inset-0 z-50 hidden">
    <!-- Modal Backdrop -->
    <div class="fixed inset-0 bg-black bg-opacity-50 transition-opacity"></div>
    
    <!-- Modal Content -->
    <div class="fixed inset-0 flex items-center justify-center p-4">
        <div class="bg-white rounded-xl shadow-xl max-w-md w-full mx-auto transform transition-all">
            <!-- Modal Header -->
            <div class="px-6 py-4 border-b border-gray-200">
                <div class="flex items-center justify-between">
                    <h3 class="text-lg font-semibold text-gray-900 flex items-center">
                        <svg class="h-6 w-6 text-red-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z"/>
                        </svg>
                        Confirm Rejection
                    </h3>
                    <button onclick="closeRejectionConfirmModal()" class="text-gray-400 hover:text-gray-600 transition-colors">
                        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                    </button>
                </div>
            </div>
            
            <!-- Modal Body -->
            <div class="px-6 py-4">
                <div class="flex items-start space-x-3">
                    <div class="flex-shrink-0">
                        <svg class="h-8 w-8 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z"/>
                        </svg>
                    </div>
                    <div class="flex-1">
                        <p class="text-sm text-gray-600 mb-3">
                            Are you sure you want to reject this leave request? This action cannot be undone.
                        </p>
                        <div class="bg-red-50 border border-red-200 rounded-md p-3">
                            <p class="text-xs text-red-700">
                                <strong>Warning:</strong> The employee will be notified with the rejection reason you provided.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Modal Footer -->
            <div class="px-6 py-4 bg-gray-50 flex justify-end space-x-3 rounded-b-xl">
                <input type="hidden" id="rejectionRequestId" />
                <button type="button" onclick="closeRejectionConfirmModal()" 
                        class="px-6 py-3 text-sm font-semibold text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#a88641] transition-colors shadow-md hover:shadow-lg">
                    Cancel
                </button>
                <button type="button" onclick="confirmRejectRequest()" 
                        class="px-6 py-3 text-sm font-semibold text-white bg-gradient-to-r from-red-600 to-red-700 hover:from-red-700 hover:to-red-800 border border-transparent rounded-lg focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 transition-all duration-200 transform hover:scale-[1.02] active:scale-[0.98] shadow-md hover:shadow-lg">
                    <span class="flex items-center">
                        <svg class="h-4 w-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z"/>
                        </svg>
                        Confirm Rejection
                    </span>
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        /* Enhanced styling for modern UI/UX */
        .form-input:focus {
            outline: none;
            ring: 2px;
            ring-color: #a88641;
            border-color: #a88641;
        }
        
        /* Custom select styling */
        select {
            background-image: none;
        }
        
        /* Button hover effects */
        .btn-hover:hover {
            transform: translateY(-1px);
            box-shadow: 0 10px 25px rgba(168, 134, 65, 0.25);
        }
        
        /* Card hover effects */
        .card-hover:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
        }
        
        /* Smooth transitions */
        .transition-smooth {
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        
        /* Mobile responsive adjustments */
        @@media (max-width: 640px) {
            .text-responsive {
                font-size: 0.875rem;
            }
        }
        
        /* Progress bar animations */
        .progress-bar {
            transition: width 0.8s cubic-bezier(0.4, 0, 0.2, 1);
        }
        
        /* Custom scrollbar for webkit browsers */
        .custom-scrollbar::-webkit-scrollbar {
            width: 6px;
        }
        
        .custom-scrollbar::-webkit-scrollbar-track {
            background: #f1f5f9;
            border-radius: 3px;
        }
        
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 3px;
        }
        
        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }

        /* Card toggle and list view styles */
        .card-details {
            overflow: hidden;
            transition: all 0.3s ease-in-out;
        }
        
        .card-toggle-btn svg {
            transition: transform 0.2s ease-in-out;
        }
        
        /* List view styles */
        .list-view {
            padding: 12px 20px !important;
            margin-bottom: 8px !important;
            border-radius: 8px !important;
            transform: none !important;
        }
        
        .list-view:hover {
            transform: none !important;
            scale: 1 !important;
        }
        
        .list-view .card-details {
            padding: 0 !important;
            margin-top: 12px;
        }
        
        .list-view .card-toggle-btn {
            display: none !important;
        }
        
        /* Improved mobile responsiveness */
        @@media (max-width: 768px) {
            .card-details {
                padding-left: 0 !important;
                padding-right: 0 !important;
            }
            
            .list-view {
                padding: 16px !important;
            }
            
            /* Stack view controls vertically on mobile */
            .flex.flex-col.lg\\:flex-row {
                flex-direction: column !important;
                gap: 1rem !important;
            }
        }
        
        /* Card expansion animations */
        .pending-request.expanded,
        .leave-history-item.expanded {
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
        }
        
        /* Enhanced view toggle buttons */
        .view-toggle-btn {
            transition: all 0.2s ease-in-out;
        }
        
        .view-toggle-btn:hover {
            transform: translateY(-1px);
        }
        
        /* Smooth card transitions */
        .pending-request,
        .leave-history-item {
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        /* Year and Month section styles */
        .year-section {
            border-radius: 0.75rem;
            overflow: hidden;
            margin-bottom: 1.5rem;
        }

        .month-section {
            border-radius: 0.5rem;
            overflow: hidden;
        }

        .year-section h3, .month-section h4 {
            user-select: none;
        }

        .months-container {
            max-height: none;
            transition: all 0.3s ease-in-out;
        }

        .months-container.hidden {
            max-height: 0;
            overflow: hidden;
            margin: 0;
            padding: 0;
        }

        .requests-container {
            max-height: none;
            transition: all 0.3s ease-in-out;
        }

        .requests-container.hidden {
            max-height: 0;
            overflow: hidden;
            margin: 0;
            padding: 0;
        }
    </style>
    
    <script>
        // Initialize filters and search when the document is ready
        document.addEventListener('DOMContentLoaded', function() {
            initializeFilters();
            initializeCharacterCounters();
        });

        // Initialize character counters for rejection reason textareas
        function initializeCharacterCounters() {
            document.querySelectorAll('textarea[id^="rejectionReason"]').forEach(textarea => {
                const charCountElement = textarea.parentElement.querySelector('.char-count');
                if (charCountElement) {
                    textarea.addEventListener('input', function() {
                        const count = this.value.length;
                        charCountElement.textContent = count;
                        
                        if (count > 500) {
                            this.value = this.value.substring(0, 500);
                            charCountElement.textContent = '500';
                        }
                    });
                }
            });
        }

        // Show approval confirmation modal
        function approveRequest(requestId) {
            if (!requestId) {
                console.error('Request ID is required');
                return;
            }
            document.getElementById('approvalRequestId').value = requestId;
            const modal = document.getElementById('approvalConfirmModal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            
            // Enhanced modal interactions
            modal.addEventListener('click', function(e) {
                if (e.target === this) {
                    closeApprovalConfirmModal();
                }
            });
            
            document.addEventListener('keydown', function escapeHandler(e) {
                if (e.key === 'Escape') {
                    closeApprovalConfirmModal();
                    document.removeEventListener('keydown', escapeHandler);
                }
            });
        }

        // Close approval confirmation modal
        function closeApprovalConfirmModal() {
            const modal = document.getElementById('approvalConfirmModal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
            document.getElementById('approvalRequestId').value = '';
        }

        // Confirm approval request
        async function confirmApproveRequest() {
            const requestId = document.getElementById('approvalRequestId').value;
            if (!requestId) {
                console.error('Request ID is required');
                return;
            }

            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            
            try {
                const response = await fetch('/LeaveManagement/Approve', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-TOKEN': token
                    },
                    body: JSON.stringify(requestId)
                });

                const result = await response.json();
                
                if (result.success) {
                    showNotification('Leave request approved successfully! 🎉', 'success');
                    setTimeout(() => {
                        location.reload();
                    }, 1500);
                } else {
                    showNotification(result.message || 'Failed to approve request', 'error');
                }
            } catch (error) {
                console.error('Error:', error);
                showNotification('An error occurred while approving the request', 'error');
            } finally {
                closeApprovalConfirmModal();
            }
        }

        // Show rejection form
        function showRejectionInput(requestId) {
            if (!requestId) {
                console.error('Request ID is required');
                return;
            }
            const form = document.getElementById(`rejectionForm${requestId}`);
            if (form) {
                form.classList.remove('hidden');
                // Focus on the textarea
                const textarea = form.querySelector('textarea');
                if (textarea) {
                    setTimeout(() => textarea.focus(), 100);
                }
            }
        }

        // Hide rejection form
        function hideRejectionInput(requestId) {
            if (!requestId) {
                console.error('Request ID is required');
                return;
            }
            const form = document.getElementById(`rejectionForm${requestId}`);
            if (form) {
                form.classList.add('hidden');
                // Clear the textarea
                const textarea = form.querySelector('textarea');
                if (textarea) {
                    textarea.value = '';
                    // Update character count
                    const charCount = form.querySelector('.char-count');
                    if (charCount) charCount.textContent = '0';
                }
            }
        }

        // Reject request
        async function rejectRequest(requestId, event) {
            if (!requestId) {
                console.error('Request ID is required');
                return;
            }

            event.preventDefault();
            const form = event.target;
            const reasonInput = form.querySelector(`#rejectionReason${requestId}`);
            
            if (!reasonInput || !reasonInput.value.trim()) {
                showNotification('Please provide a rejection reason', 'error');
                return;
            }

            // Store the rejection reason in a data attribute
            const modal = document.getElementById('rejectionConfirmModal');
            modal.setAttribute('data-rejection-reason', reasonInput.value.trim());
            document.getElementById('rejectionRequestId').value = requestId;
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            
            // Enhanced modal interactions
            modal.addEventListener('click', function(e) {
                if (e.target === this) {
                    closeRejectionConfirmModal();
                }
            });
            
            document.addEventListener('keydown', function escapeHandler(e) {
                if (e.key === 'Escape') {
                    closeRejectionConfirmModal();
                    document.removeEventListener('keydown', escapeHandler);
                }
            });
        }

        // Confirm reject request
        async function confirmRejectRequest() {
            const requestId = document.getElementById('rejectionRequestId').value;
            if (!requestId) {
                console.error('Request ID is required');
                return;
            }

            const modal = document.getElementById('rejectionConfirmModal');
            const rejectionReason = modal.getAttribute('data-rejection-reason');
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            if (!rejectionReason) {
                showNotification('Please provide a rejection reason', 'error');
                return;
            }

            try {
                const response = await fetch('/LeaveManagement/Reject', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-TOKEN': token
                    },
                    body: JSON.stringify({
                        id: parseInt(requestId),
                        rejectionReason: rejectionReason
                    })
                });

                const result = await response.json();
                
                if (result.success) {
                    showNotification('Leave request rejected successfully', 'success');
                    setTimeout(() => {
                        location.reload();
                    }, 1500);
                } else {
                    showNotification(result.message || 'Failed to reject request', 'error');
                }
            } catch (error) {
                console.error('Error:', error);
                showNotification('An error occurred while rejecting the request', 'error');
            } finally {
                closeRejectionConfirmModal();
            }
        }

        function closeRejectionConfirmModal() {
            const modal = document.getElementById('rejectionConfirmModal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
            document.getElementById('rejectionRequestId').value = '';
            modal.removeAttribute('data-rejection-reason');
        }

        // Enhanced notification system
        function showNotification(message, type = 'info') {
            const container = document.getElementById('notificationContainer');
            const notification = document.createElement('div');
            
            notification.className = `transform transition-all duration-500 ease-out p-4 mb-4 rounded-xl shadow-lg border max-w-sm ${
                type === 'success' 
                    ? 'bg-green-50 text-green-800 border-green-200' 
                    : type === 'error' 
                        ? 'bg-red-50 text-red-800 border-red-200'
                        : 'bg-blue-50 text-blue-800 border-blue-200'
            }`;
            
            notification.innerHTML = `
                <div class="flex items-start">
                    <div class="flex-shrink-0">
                        <svg class="h-5 w-5 mt-0.5 ${
                            type === 'success' ? 'text-green-600' : type === 'error' ? 'text-red-600' : 'text-blue-600'
                        }" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            ${type === 'success' 
                                ? '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>'
                                : type === 'error'
                                    ? '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>'
                                    : '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>'
                            }
                        </svg>
                    </div>
                    <div class="ml-3 flex-1">
                        <p class="text-sm font-medium leading-5">${message}</p>
                    </div>
                    <div class="ml-4 flex-shrink-0">
                        <button onclick="this.parentElement.parentElement.parentElement.remove()" 
                                class="inline-flex text-gray-400 hover:text-gray-600 transition-colors duration-200">
                            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                            </svg>
                        </button>
                    </div>
                </div>
            `;
            
            // Enhanced animation
            notification.style.opacity = '0';
            notification.style.transform = 'translateX(100%) scale(0.95)';
            
            container.appendChild(notification);
            
            // Trigger animation
            requestAnimationFrame(() => {
                notification.style.opacity = '1';
                notification.style.transform = 'translateX(0) scale(1)';
            });
            
            // Auto-remove after 5 seconds
            setTimeout(() => {
                notification.style.opacity = '0';
                notification.style.transform = 'translateX(100%) scale(0.95)';
                setTimeout(() => {
                    if (notification.parentNode) {
                        notification.remove();
                    }
                }, 500);
            }, 5000);
        }

        function initializeFilters() {
            // Pending requests filters
            const pendingSearch = document.getElementById('pendingSearch');
            const pendingStatusFilter = document.getElementById('pendingStatusFilter');
            
            if (pendingSearch && pendingStatusFilter) {
                pendingSearch.addEventListener('input', () => filterPendingRequests());
                pendingStatusFilter.addEventListener('change', () => filterPendingRequests());
            }

            // History filters
            const historySearch = document.getElementById('historySearch');
            const historyStatusFilter = document.getElementById('historyStatusFilter');
            
            if (historySearch && historyStatusFilter) {
                historySearch.addEventListener('input', () => filterHistoryRequests());
                historyStatusFilter.addEventListener('change', () => filterHistoryRequests());
            }
        }

        function filterPendingRequests() {
            const searchTerm = document.getElementById('pendingSearch').value.toLowerCase();
            const statusFilter = document.getElementById('pendingStatusFilter').value;
            const requests = document.querySelectorAll('.pending-request');

            requests.forEach(request => {
                const employeeName = request.querySelector('.employee-name').textContent.toLowerCase();
                const employeeEmail = request.querySelector('.employee-email').textContent.toLowerCase();
                const leaveType = request.querySelector('.leave-type').textContent.toLowerCase();
                const reason = request.querySelector('.leave-reason').textContent.toLowerCase();
                const status = request.dataset.status.toLowerCase();

                const matchesSearch = employeeName.includes(searchTerm) || 
                                    employeeEmail.includes(searchTerm) || 
                                    leaveType.includes(searchTerm) || 
                                    reason.includes(searchTerm);

                const matchesStatus = statusFilter === 'all' || status === statusFilter;

                request.style.display = matchesSearch && matchesStatus ? 'block' : 'none';
            });
        }

        function filterHistoryRequests() {
            const searchTerm = document.getElementById('historySearch').value.toLowerCase();
            const statusFilter = document.getElementById('historyStatusFilter').value;
            const requests = document.querySelectorAll('.leave-history-item');

            requests.forEach(request => {
                const employeeName = request.querySelector('.employee-name').textContent.toLowerCase();
                const employeeEmail = request.querySelector('.employee-email').textContent.toLowerCase();
                const leaveType = request.querySelector('.leave-type').textContent.toLowerCase();
                const reason = request.querySelector('.leave-reason').textContent.toLowerCase();
                const status = request.dataset.status.toLowerCase();

                const matchesSearch = employeeName.includes(searchTerm) || 
                                    employeeEmail.includes(searchTerm) || 
                                    leaveType.includes(searchTerm) || 
                                    reason.includes(searchTerm);

                const matchesStatus = statusFilter === 'all' || status === statusFilter;

                request.style.display = matchesSearch && matchesStatus ? 'block' : 'none';
            });
        }

        // View Toggle and Card Management Functions
        let currentPendingView = 'cards';
        let currentHistoryView = 'grouped';

        // Group history requests by year and month
        function groupHistoryRequests() {
            const requests = document.querySelectorAll('.leave-history-item');
            const container = document.getElementById('historyContainer');
            const groupedRequests = {};

            // Extract original request elements before clearing
            const originalRequests = Array.from(requests).map(req => req.cloneNode(true));

            // Clear existing content
            container.innerHTML = '';
            container.className = 'divide-y divide-gray-200 max-h-[600px] overflow-y-auto';

            // If no requests, show empty state
            if (originalRequests.length === 0) {
                container.innerHTML = `
                    <div class="p-6 text-center">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-gray-400 mx-auto mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                        </svg>
                        <p class="text-gray-500 mb-1">No leave history found</p>
                        <p class="text-sm text-gray-400">There are no processed leave requests</p>
                    </div>
                `;
                return;
            }

            // Group requests by year and month using submission date
            originalRequests.forEach(request => {
                // Try to get date from various possible sources
                let dateString = request.dataset.date;
                if (!dateString) {
                    // Extract date from the request content if dataset.date is not available
                    const dateText = request.textContent;
                    const dateMatch = dateText.match(/\b(\w+)\s+(\d{1,2}),?\s+(\d{4})\b/);
                    if (dateMatch) {
                        dateString = `${dateMatch[1]} ${dateMatch[2]}, ${dateMatch[3]}`;
                    }
                }
                
                const date = dateString ? new Date(dateString) : new Date();
                const year = date.getFullYear();
                const month = date.toLocaleString('default', { month: 'long' });

                if (!groupedRequests[year]) {
                    groupedRequests[year] = {};
                }
                if (!groupedRequests[year][month]) {
                    groupedRequests[year][month] = [];
                }
                groupedRequests[year][month].push(request);
            });

            // Create collapsible sections for each year and month
            Object.keys(groupedRequests)
                .sort((a, b) => b - a) // Sort years in descending order
                .forEach(year => {
                    const yearSection = document.createElement('div');
                    yearSection.className = 'year-section mb-6';

                    // Create year header
                    const yearHeader = document.createElement('div');
                    yearHeader.className = 'flex items-center justify-between bg-gradient-to-r from-blue-50 to-indigo-50 p-4 rounded-lg cursor-pointer hover:from-blue-100 hover:to-indigo-100 transition-colors mb-3 border border-blue-200';
                    yearHeader.innerHTML = `
                        <h3 class="text-xl font-bold text-gray-900 flex items-center">
                            <svg class="h-6 w-6 text-blue-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                            </svg>
                            ${year}
                        </h3>
                        <div class="flex items-center space-x-2">
                            <span class="text-sm text-gray-600 bg-white px-3 py-1 rounded-full border">
                                ${Object.values(groupedRequests[year]).reduce((total, monthRequests) => total + monthRequests.length, 0)} requests
                            </span>
                            <svg class="h-5 w-5 text-gray-600 transform transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                            </svg>
                        </div>
                    `;

                    // Create container for months
                    const monthsContainer = document.createElement('div');
                    monthsContainer.className = 'months-container ml-6 space-y-3';

                    // Sort months in reverse chronological order
                    const months = Object.keys(groupedRequests[year]).sort((a, b) => {
                        return new Date(Date.parse(`${a} 1, 2000`)) - new Date(Date.parse(`${b} 1, 2000`));
                    }).reverse();

                    months.forEach(month => {
                        const monthSection = document.createElement('div');
                        monthSection.className = 'month-section mb-4';

                        // Create month header
                        const monthHeader = document.createElement('div');
                        monthHeader.className = 'flex items-center justify-between bg-gradient-to-r from-gray-50 to-slate-50 p-3 rounded-lg cursor-pointer hover:from-gray-100 hover:to-slate-100 transition-colors mb-2 border border-gray-200';
                        monthHeader.innerHTML = `
                            <h4 class="text-lg font-semibold text-gray-800 flex items-center">
                                <svg class="h-5 w-5 text-gray-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                </svg>
                                ${month}
                            </h4>
                            <div class="flex items-center space-x-2">
                                <span class="text-xs text-gray-500 bg-white px-2 py-1 rounded-full border">
                                    ${groupedRequests[year][month].length} requests
                                </span>
                                <svg class="h-4 w-4 text-gray-500 transform transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                                </svg>
                            </div>
                        `;

                        // Create container for requests
                        const requestsContainer = document.createElement('div');
                        requestsContainer.className = 'requests-container ml-4 space-y-3';

                        // Sort requests by date within each month
                        const sortedRequests = groupedRequests[year][month].sort((a, b) => {
                            const dateA = new Date(a.dataset.date || new Date());
                            const dateB = new Date(b.dataset.date || new Date());
                            return dateB - dateA; // Sort in descending order
                        });

                        // Add requests to container
                        sortedRequests.forEach(request => {
                            requestsContainer.appendChild(request);
                        });

                        monthSection.appendChild(monthHeader);
                        monthSection.appendChild(requestsContainer);
                        monthsContainer.appendChild(monthSection);

                        // Add click handler for month header
                        monthHeader.addEventListener('click', () => {
                            requestsContainer.classList.toggle('hidden');
                            monthHeader.querySelector('svg').classList.toggle('rotate-180');
                        });
                    });

                    yearSection.appendChild(yearHeader);
                    yearSection.appendChild(monthsContainer);
                    container.appendChild(yearSection);

                    // Add click handler for year header
                    yearHeader.addEventListener('click', () => {
                        monthsContainer.classList.toggle('hidden');
                        yearHeader.querySelector('svg').classList.toggle('rotate-180');
                    });
                });

            // Expand the most recent year and month by default
            const firstYearSection = container.querySelector('.year-section');
            const firstMonthSection = firstYearSection?.querySelector('.month-section');
            if (firstYearSection && firstMonthSection) {
                firstYearSection.querySelector('.months-container').classList.remove('hidden');
                firstYearSection.querySelector('svg').classList.add('rotate-180');
                firstMonthSection.querySelector('.requests-container').classList.remove('hidden');
                firstMonthSection.querySelector('svg').classList.add('rotate-180');
            }
        }

        // Toggle Pending View (Cards/List)
        function togglePendingView(viewType) {
            currentPendingView = viewType;
            const cardsBtn = document.getElementById('pendingCardsViewBtn');
            const listBtn = document.getElementById('pendingListViewBtn');
            const cardControls = document.getElementById('pendingCardControls');
            const requests = document.querySelectorAll('.pending-request');

            if (viewType === 'cards') {
                // Update button states
                if (cardsBtn) cardsBtn.className = 'flex items-center px-3 py-1.5 text-sm font-medium rounded-md transition-all duration-200 bg-white text-gray-900 shadow-sm';
                if (listBtn) listBtn.className = 'flex items-center px-3 py-1.5 text-sm font-medium rounded-md transition-all duration-200 text-gray-600 hover:text-gray-900';
                
                // Show card controls
                if (cardControls) cardControls.style.display = 'flex';
                
                // Switch to cards view
                requests.forEach(card => {
                    card.className = card.className.replace(/\blist-view\b/g, '').trim();
                    card.style.marginBottom = '';
                });
            } else {
                // Update button states
                if (listBtn) listBtn.className = 'flex items-center px-3 py-1.5 text-sm font-medium rounded-md transition-all duration-200 bg-white text-gray-900 shadow-sm';
                if (cardsBtn) cardsBtn.className = 'flex items-center px-3 py-1.5 text-sm font-medium rounded-md transition-all duration-200 text-gray-600 hover:text-gray-900';
                
                // Hide card controls
                if (cardControls) cardControls.style.display = 'none';
                
                // Switch to list view
                requests.forEach(card => {
                    card.className += ' list-view';
                    card.style.marginBottom = '8px';
                    // Expand all cards in list view for better readability
                    expandCard(card);
                });
            }
        }

        // Toggle History View (Grouped/Grid)
        function toggleHistoryView(viewType) {
            const groupedBtn = document.getElementById('historyGroupedViewBtn');
            const gridBtn = document.getElementById('historyGridViewBtn');
            const groupControls = document.getElementById('historyGroupControls');
            const container = document.getElementById('historyContainer');

            if (viewType === 'grouped') {
                // Update button states
                groupedBtn.className = 'flex items-center px-3 py-1.5 text-sm font-medium rounded-md transition-all duration-200 bg-white text-gray-900 shadow-sm';
                gridBtn.className = 'flex items-center px-3 py-1.5 text-sm font-medium rounded-md transition-all duration-200 text-gray-600 hover:text-gray-900';
                
                // Show group controls
                groupControls.style.display = 'flex';
                
                // Apply grouped view with year/month grouping
                groupHistoryRequests();
                
                currentHistoryView = 'grouped';
                showNotification('Switched to grouped view', 'info');
            } else if (viewType === 'grid') {
                // Update button states
                groupedBtn.className = 'flex items-center px-3 py-1.5 text-sm font-medium rounded-md transition-all duration-200 text-gray-600 hover:text-gray-900';
                gridBtn.className = 'flex items-center px-3 py-1.5 text-sm font-medium rounded-md transition-all duration-200 bg-white text-gray-900 shadow-sm';
                
                // Hide group controls
                groupControls.style.display = 'none';
                
                // Apply grid view
                const originalRequests = Array.from(document.querySelectorAll('.leave-history-item')).map(req => req.cloneNode(true));
                container.innerHTML = '';
                container.className = 'grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4 p-4';
                
                if (originalRequests.length === 0) {
                    container.innerHTML = `
                        <div class="col-span-full p-6 text-center">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-gray-400 mx-auto mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                            </svg>
                            <p class="text-gray-500 mb-1">No leave history found</p>
                            <p class="text-sm text-gray-400">There are no processed leave requests</p>
                        </div>
                    `;
                } else {
                    originalRequests.forEach(request => {
                        // Simplify cards for grid view
                        request.className = 'leave-history-item bg-white rounded-lg border shadow-sm hover:shadow-md transition-all duration-200 ' + request.className.split(' ').filter(c => c.startsWith('border-')).join(' ');
                        
                        // Hide the toggle button and show details
                        const toggleBtn = request.querySelector('.card-toggle-btn');
                        const details = request.querySelector('.card-details');
                        if (toggleBtn) toggleBtn.style.display = 'none';
                        if (details) details.style.display = 'block';
                        
                        container.appendChild(request);
                    });
                }
                
                currentHistoryView = 'grid';
                showNotification('Switched to grid view', 'info');
            }
        }

        // Card Toggle Functions
        function toggleCard(cardElement) {
            const isPending = cardElement.classList.contains('pending-request');
            const currentView = isPending ? currentPendingView : currentHistoryView;
            
            if (currentView === 'list') return; // Don't toggle in list view
            
            const details = cardElement.querySelector('.card-details');
            const toggleBtn = cardElement.querySelector('.card-toggle-btn svg');
            
            if (details && toggleBtn) {
                if (details.style.display === 'none' || !details.style.display) {
                    // Expand
                    expandCard(cardElement);
                } else {
                    // Collapse
                    collapseCard(cardElement);
                }
            }
        }

        function expandCard(cardElement) {
            const details = cardElement.querySelector('.card-details');
            const toggleBtn = cardElement.querySelector('.card-toggle-btn svg');
            
            if (details && toggleBtn) {
                details.style.display = 'block';
                toggleBtn.style.transform = 'rotate(180deg)';
                cardElement.classList.add('expanded');
            }
        }

        function collapseCard(cardElement) {
            const details = cardElement.querySelector('.card-details');
            const toggleBtn = cardElement.querySelector('.card-toggle-btn svg');
            
            if (details && toggleBtn) {
                details.style.display = 'none';
                toggleBtn.style.transform = 'rotate(0deg)';
                cardElement.classList.remove('expanded');
            }
        }

        // Collapse All Pending Cards
        function collapseAllPending() {
            if (currentPendingView === 'list') return;
            
            const cards = document.querySelectorAll('.pending-request');
            cards.forEach(card => collapseCard(card));
            
            showNotification('All pending cards collapsed', 'info');
        }

        // Expand All Pending Cards
        function expandAllPending() {
            if (currentPendingView === 'list') return;
            
            const cards = document.querySelectorAll('.pending-request');
            cards.forEach(card => expandCard(card));
            
            showNotification('All pending cards expanded', 'info');
        }

        // Collapse All History Cards
        function collapseAllHistory() {
            if (currentHistoryView === 'list') return;
            
            const cards = document.querySelectorAll('.leave-history-item');
            cards.forEach(card => collapseCard(card));
            
            showNotification('All history cards collapsed', 'info');
        }

        // Expand All History Cards
        function expandAllHistory() {
            if (currentHistoryView === 'list') return;
            
            const cards = document.querySelectorAll('.leave-history-item');
            cards.forEach(card => expandCard(card));
            
            showNotification('All history cards expanded', 'info');
        }

        // Initialize views on page load
        document.addEventListener('DOMContentLoaded', function() {
            // Initialize cards as collapsed by default
            const allCards = document.querySelectorAll('.pending-request, .leave-history-item');
            allCards.forEach(card => collapseCard(card));
            
            // Set initial views
            currentHistoryView = 'grouped';
            
            // Initialize grouped view for history
            groupHistoryRequests();
        });

        // Collapse All History Groups
        function collapseAllHistoryGroups() {
            if (currentHistoryView !== 'grouped') return;
            
            const yearSections = document.querySelectorAll('.year-section');
            yearSections.forEach(yearSection => {
                const monthsContainer = yearSection.querySelector('.months-container');
                const yearChevron = yearSection.querySelector('svg');
                
                if (!monthsContainer.classList.contains('hidden')) {
                    monthsContainer.classList.add('hidden');
                    yearChevron.classList.remove('rotate-180');
                }
                
                // Also collapse all month sections within
                const monthSections = yearSection.querySelectorAll('.month-section');
                monthSections.forEach(monthSection => {
                    const requestsContainer = monthSection.querySelector('.requests-container');
                    const monthChevron = monthSection.querySelector('svg');
                    
                    if (!requestsContainer.classList.contains('hidden')) {
                        requestsContainer.classList.add('hidden');
                        monthChevron.classList.remove('rotate-180');
                    }
                });
            });
            
            showNotification('All groups collapsed', 'info');
        }

        // Expand All History Groups
        function expandAllHistoryGroups() {
            if (currentHistoryView !== 'grouped') return;
            
            const yearSections = document.querySelectorAll('.year-section');
            yearSections.forEach(yearSection => {
                const monthsContainer = yearSection.querySelector('.months-container');
                const yearChevron = yearSection.querySelector('svg');
                
                if (monthsContainer.classList.contains('hidden')) {
                    monthsContainer.classList.remove('hidden');
                    yearChevron.classList.add('rotate-180');
                }
                
                // Also expand all month sections within
                const monthSections = yearSection.querySelectorAll('.month-section');
                monthSections.forEach(monthSection => {
                    const requestsContainer = monthSection.querySelector('.requests-container');
                    const monthChevron = monthSection.querySelector('svg');
                    
                    if (requestsContainer.classList.contains('hidden')) {
                        requestsContainer.classList.remove('hidden');
                        monthChevron.classList.add('rotate-180');
                    }
                });
            });
            
            showNotification('All groups expanded', 'info');
        }
    </script>
}
