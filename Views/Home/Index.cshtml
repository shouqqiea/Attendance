@{
    ViewData["Title"] = "Home";
}

<!-- Hero Section -->
<section class="pt-16 pb-12 bg-gradient-to-br from-[#a88641] to-[#916f34]">
    <div class="max-w-6xl mx-auto px-4">
        <div class="flex flex-col md:flex-row items-center">
            <div class="md:w-1/2 text-center md:text-left text-white">
                <h1 class="text-3xl md:text-4xl font-bold leading-tight">
                    Advanced Attendance System for Malaysian Businesses
                </h1>
                <p class="mt-4 text-lg md:text-xl text-gray-100">
                    Secure biometric sign-in with GPS verification
                </p>
                <div class="mt-8 flex flex-col sm:flex-row justify-center md:justify-start space-y-4 sm:space-y-0 sm:space-x-4">
                    <button class="px-6 py-2 bg-white text-[#a88641] font-medium rounded-md shadow-md hover:bg-gray-50 transition-colors">
                        Get Started
                    </button>
                </div>
            </div>
            <div class="md:w-1/2 mt-12 md:mt-0">
                <div class="bg-white rounded-lg shadow-lg overflow-hidden max-w-md mx-auto">
                    <div class="p-4 bg-gray-50 border-b">
                        <div class="flex items-center">
                            <div class="h-3 w-3 bg-red-500 rounded-full mr-2"></div>
                            <div class="h-3 w-3 bg-yellow-500 rounded-full mr-2"></div>
                            <div class="h-3 w-3 bg-green-500 rounded-full"></div>
                        </div>
                    </div>
                    <div class="p-6">
                        <div class="flex justify-between items-center mb-6">
                            <h3 class="text-lg font-semibold text-gray-800">Biometric Check-In</h3>
                            <span class="text-sm text-gray-500">10:15 AM</span>
                        </div>
                        <div class="space-y-4">
                            <div class="flex justify-center mb-4">
                                <div class="h-24 w-24 rounded-full bg-gray-200 flex items-center justify-center overflow-hidden border-4 border-[#a88641]">
                                    <svg class="h-16 w-16 text-gray-400" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"></path>
                                    </svg>
                                </div>
                            </div>
                            <div class="text-center mb-4">
                                <p class="text-green-600 font-medium">Face recognized</p>
                                <p class="text-sm text-gray-500">Ahmad bin Ismail</p>
                            </div>
                            <div class="bg-green-50 p-3 rounded-md">
                                <div class="flex items-center">
                                    <svg class="h-5 w-5 text-green-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                    </svg>
                                    <div>
                                        <p class="text-sm font-medium text-gray-900">Location Verified</p>
                                        <p class="text-xs text-gray-500">Kuala Lumpur, Malaysia</p>
                                    </div>
                                </div>
                            </div>
                            <div class="mt-6">
                                <button class="w-full py-2 bg-[#a88641] text-white rounded-md hover:bg-[#916f34] transition-colors">
                                    Check In
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Malaysia Business Badge -->
<section class="py-6 bg-white">
    <div class="max-w-6xl mx-auto px-4">
        <div class="flex flex-wrap justify-center items-center gap-8">
            <div class="flex items-center">
                <div class="h-12 w-12 flex items-center justify-center">
                    <svg class="h-10 w-10 text-[#a88641]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
                    </svg>
                </div>
                <div class="ml-2">
                    <p class="text-sm font-medium text-gray-900">SST Compliant</p>
                </div>
            </div>
            <div class="flex items-center">
                <div class="h-12 w-12 flex items-center justify-center">
                    <svg class="h-10 w-10 text-[#a88641]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3"></path>
                    </svg>
                </div>
                <div class="ml-2">
                    <p class="text-sm font-medium text-gray-900">PDPA Compliant</p>
                </div>
            </div>
            <div class="flex items-center">
                <div class="h-12 w-12 flex items-center justify-center">
                    <svg class="h-10 w-10 text-[#a88641]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                    </svg>
                </div>
                <div class="ml-2">
                    <p class="text-sm font-medium text-gray-900">EA Form Ready</p>
                </div>
            </div>
            <div class="flex items-center">
                <div class="h-12 w-12 flex items-center justify-center">
                    <svg class="h-10 w-10 text-[#a88641]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a1.994 1.994 0 01-1.414-.586m0 0L11 14h4a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2v4l.586-.586z"></path>
                    </svg>
                </div>
                <div class="ml-2">
                    <p class="text-sm font-medium text-gray-900">Bahasa Malaysia</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Features Section -->
<section class="py-16 bg-gray-50">
    <div class="max-w-6xl mx-auto px-4">
        <div class="text-center mb-12">
            <h2 class="text-2xl md:text-3xl font-bold text-gray-900">
                Advanced Features for Modern Businesses
            </h2>
            <div class="mt-2 flex justify-center">
                <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-[#a88641] bg-opacity-10 text-[#916f34]">
                    <svg class="mr-1.5 h-4 w-4 text-[#a88641]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                    </svg>
                    Enterprise Ready
                </span>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <!-- Feature Card 1 -->
            <div class="bg-white rounded-xl overflow-hidden shadow-sm border border-gray-200">
                <div class="p-6">
                    <div class="h-12 w-12 bg-[#a88641] bg-opacity-10 rounded-lg flex items-center justify-center mb-4">
                        <svg class="h-6 w-6 text-[#a88641]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 11c0 3.517-1.009 6.799-2.753 9.571m-3.44-2.04l.054-.09A13.916 13.916 0 008 11a4 4 0 118 0c0 1.017-.07 2.019-.203 3m-2.118 6.844A21.88 21.88 0 0015.171 17m3.839 1.132c.645-2.266.99-4.659.99-7.132A8 8 0 008 4.07M3 15.364c.64-1.319 1-2.8 1-4.364 0-1.457.39-2.823 1.07-4"></path>
                        </svg>
                    </div>
                    <h3 class="text-lg font-semibold text-gray-900 mb-2">Facial Recognition</h3>
                    <p class="text-gray-600">Advanced biometric authentication for secure and accurate attendance tracking.</p>
                </div>
            </div>

            <!-- Feature Card 2 -->
            <div class="bg-white rounded-xl overflow-hidden shadow-sm border border-gray-200">
                <div class="p-6">
                    <div class="h-12 w-12 bg-[#a88641] bg-opacity-10 rounded-lg flex items-center justify-center mb-4">
                        <svg class="h-6 w-6 text-[#a88641]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                        </svg>
                    </div>
                    <h3 class="text-lg font-semibold text-gray-900 mb-2">GPS Verification</h3>
                    <p class="text-gray-600">Location-based attendance tracking with precise geofencing capabilities.</p>
                </div>
            </div>

            <!-- Feature Card 3 -->
            <div class="bg-white rounded-xl overflow-hidden shadow-sm border border-gray-200">
                <div class="p-6">
                    <div class="h-12 w-12 bg-[#a88641] bg-opacity-10 rounded-lg flex items-center justify-center mb-4">
                        <svg class="h-6 w-6 text-[#a88641]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path>
                        </svg>
                    </div>
                    <h3 class="text-lg font-semibold text-gray-900 mb-2">Leave Management</h3>
                    <p class="text-gray-600">Streamlined leave requests and approvals with automated workflows.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Call to Action -->
<section class="py-16 bg-[#a88641]">
    <div class="max-w-4xl mx-auto px-4 text-center">
        <h2 class="text-2xl md:text-3xl font-bold text-white mb-4">
            Ready to Transform Your Attendance Management?
        </h2>
        <p class="text-lg text-gray-100 mb-8">
            Join thousands of companies already using LetsCheckIn to streamline their operations.
        </p>
        <button class="px-8 py-3 bg-white text-[#a88641] font-medium rounded-md shadow-md hover:bg-gray-50 transition-colors">
            Start Free Trial
        </button>
    </div>
</section>
