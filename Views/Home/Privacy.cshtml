@{
    ViewData["Title"] = "Privacy Policy";
    Layout = "~/Views/Shared/_AuthenticatedLayout.cshtml";
}

<div class="p-6">
    <!-- Header Section with Branding -->
    <div class="mb-8 flex items-center justify-between">
        <div>
            <div class="flex items-center mb-2">
                <h2 class="text-2xl font-bold text-gray-900">Privacy Policy</h2>
                <span class="ml-2 bg-indigo-100 text-indigo-800 text-xs px-2 py-0.5 rounded-full">Legal</span>
            </div>
            <p class="text-sm text-gray-600">Last updated: @DateTime.Now.ToString("MMMM dd, yyyy")</p>
        </div>
        <div class="flex items-center">
            <img src="/images/logo-black-icon.png" alt="Logo" class="h-7 w-7" />
            <h1 class="text-lg font-bold text-gray-900 ml-2">Lets<span class="text-[#a88641]">Check</span>In</h1>
        </div>
    </div>

    <!-- Content Section -->
    <div class="bg-white rounded-lg shadow-sm p-6">
        <div class="prose max-w-none">
            <p class="text-gray-600">Join thousands of companies already using LetsCheckIn to streamline their operations.</p>
            
            <h2 class="text-xl font-semibold mt-8 mb-4 text-gray-900">Information We Collect</h2>
            <p class="text-gray-600 mb-4">We collect information that you provide directly to us, including:</p>
            <ul class="list-disc pl-6 mb-4 text-gray-600 space-y-2">
                <li>Name and contact information</li>
                <li>Login credentials</li>
                <li>Location data (when enabled)</li>
                <li>Network information (when enabled)</li>
                <li>Facial recognition data (when enabled)</li>
                <li>Attendance records</li>
            </ul>

            <h2 class="text-xl font-semibold mt-8 mb-4 text-gray-900">How We Use Your Information</h2>
            <p class="text-gray-600 mb-4">We use the information we collect to:</p>
            <ul class="list-disc pl-6 mb-4 text-gray-600 space-y-2">
                <li>Provide and maintain our services</li>
                <li>Process attendance records</li>
                <li>Verify your identity</li>
                <li>Send notifications and updates</li>
                <li>Improve our services</li>
                <li>Comply with legal obligations</li>
            </ul>

            <h2 class="text-xl font-semibold mt-8 mb-4 text-gray-900">Data Security</h2>
            <p class="text-gray-600 mb-4">We implement appropriate security measures to protect your personal information, including:</p>
            <ul class="list-disc pl-6 mb-4 text-gray-600 space-y-2">
                <li>Encryption of data in transit and at rest</li>
                <li>Regular security assessments</li>
                <li>Access controls and authentication</li>
                <li>Secure data centers</li>
            </ul>

            <h2 class="text-xl font-semibold mt-8 mb-4 text-gray-900">Your Rights</h2>
            <p class="text-gray-600 mb-4">You have the right to:</p>
            <ul class="list-disc pl-6 mb-4 text-gray-600 space-y-2">
                <li>Access your personal information</li>
                <li>Correct inaccurate data</li>
                <li>Request deletion of your data</li>
                <li>Object to processing</li>
                <li>Data portability</li>
            </ul>

            <h2 class="text-xl font-semibold mt-8 mb-4 text-gray-900">Contact Us</h2>
            <p class="text-gray-600 mb-4">If you have any questions about this Privacy Policy, please contact us at:</p>
            <div class="bg-gray-50 rounded-lg p-4 text-gray-600">
                <p class="mb-2 font-medium">LetsCheckIn</p>
                <p>Email: privacy@letscheckin.com</p>
                <p>123 Business Street</p>
                <p>Tech City, TC 12345</p>
                <p>United States</p>
            </div>
        </div>
    </div>
</div>
